#!/usr/bin/env bash
# Runs a command against the local AWS Emulator (the aws-emulator service in compose.yaml) instead
# of real AWS. Examples:
#   infra/docker/aws-emulator/aws-local aws sts get-caller-identity
#   infra/docker/aws-emulator/aws-local aws s3 ls
# Your own shell is left unchanged. Your AWS credentials, profiles and other AWS settings are kept
# out of the command, so nothing it sends is signed with your real credentials.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: $0 <command> [args...], for example: $0 aws s3 ls" >&2
  exit 1
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
endpoint=https://127.0.0.1:9297
region=eu-west-1

# A private folder for this invocation alone, removed when the command finishes, so commands run
# at the same time never read files another one is still writing.
umask 077
tmp="${TMPDIR:-/tmp}"
dir="$(mktemp -d "${tmp%/}/aws-local.XXXXXX")"
trap 'rm -rf "$dir"' EXIT

# The emulator makes a new certificate and new access keys every time it starts, so fetch this
# run's copies from the container each time. One call for both files; the line between them
# cannot appear in either.
boundary='--- aws-emulator file boundary ---'
if ! files="$(cd "$root" && docker compose exec -T aws-emulator sh -c \
  "cd \"\$HOME/.aws/emulator/9297\" && cat ca.pem && echo '$boundary' && cat emulator_credentials" \
  2>"$dir/docker-error")"; then
  echo "Could not fetch the AWS Emulator's certificate and keys from its container. Docker said:" >&2
  sed 's/^/  /' "$dir/docker-error" >&2
  echo "If the emulator isn't running, or is still starting: docker compose up -d --wait aws-emulator" >&2
  exit 1
fi

printf '%s\n' "${files%%$'\n'"$boundary"*}" > "$dir/ca.pem"
printf '%s\n' "${files#*"$boundary"$'\n'}" > "$dir/emulator_credentials"
# Our own config file rather than yours, so no profile of yours (SSO, assumed roles) is used.
cat > "$dir/config" <<EOF
[default]
region = $region
endpoint_url = $endpoint
ca_bundle = $dir/ca.pem
EOF

# Node.js reads only one extra CA file, so keep any of yours (a corporate CA, say) alongside the
# emulator's instead of replacing it.
node_ca="$dir/ca.pem"
if [[ -n "${NODE_EXTRA_CA_CERTS:-}" && -r "$NODE_EXTRA_CA_CERTS" ]]; then
  node_ca="$dir/node-extra-ca.pem"
  cat "$NODE_EXTRA_CA_CERTS" "$dir/ca.pem" > "$node_ca"
fi

# Clear every AWS setting from your environment, not just credentials: some would send requests
# elsewhere, such as a service's own endpoint (AWS_ENDPOINT_URL_S3, which beats AWS_ENDPOINT_URL) or
# AWS_IGNORE_CONFIGURED_ENDPOINT_URLS, which ignores the emulator's endpoint altogether.
while IFS= read -r name; do
  unset "$name"
done < <(compgen -e AWS_)

export AWS_ENDPOINT_URL="$endpoint"
export AWS_SHARED_CREDENTIALS_FILE="$dir/emulator_credentials"
export AWS_CONFIG_FILE="$dir/config"
export AWS_CA_BUNDLE="$dir/ca.pem"
export NODE_EXTRA_CA_CERTS="$node_ca"
export AWS_EC2_METADATA_DISABLED=true
export AWS_REGION="$region"
export AWS_DEFAULT_REGION="$region"
export AWS_PAGER=""
# The emulator is on this machine, so a proxy set in your environment must not carry the requests.
# Tools differ in which spelling they read, so set both.
export NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"
export no_proxy="127.0.0.1,localhost${no_proxy:+,$no_proxy}"

# Not exec, so the EXIT trap can remove the folder afterwards. The exit status is the command's.
"$@"
