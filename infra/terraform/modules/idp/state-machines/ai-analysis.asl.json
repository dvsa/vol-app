{
  "Comment": "Analyse extracted bank statement data with an AI model following DVSA rules",
  "StartAt": "FetchCustomOutput",
  "TimeoutSeconds": 600,
  "States": {
    "FetchCustomOutput": {
      "Type": "Task",
      "Comment": "Invokes extract-s3-json-field Lambda to fetch the BDA custom output and return ONLY the inference_result subtree. The full result.json carries inference_metadata + explanations (bounding boxes per field) which can exceed the Step Functions 256KB state limit on busy statements.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EXTRACT_S3_JSON_FIELD_LAMBDA_ARN}",
        "Payload": {
          "bucket.$": "$.extractedDataS3Bucket",
          "key.$": "States.Format('{}{}/0/custom_output/0/result.json', $.extractedDataS3KeyPrefix, $.bedrockInvocationId)",
          "fieldPath": "inference_result"
        }
      },
      "ResultSelector": {
        "content.$": "$.Payload"
      },
      "ResultPath": "$.customOutput",
      "Next": "FetchStandardOutput",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "EmitFailedEvent"
        }
      ]
    },
    "FetchStandardOutput": {
      "Type": "Task",
      "Comment": "Invokes extract-s3-json-field Lambda to fetch the BDA standard output and return ONLY the markdown at document.representation.markdown - skipping the description/statistics/summary/metadata wrapper. Note: the field is named after the configured textFormat (we set ['MARKDOWN'] in CDK); if more than one format is enabled BDA names the field 'text' instead.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EXTRACT_S3_JSON_FIELD_LAMBDA_ARN}",
        "Payload": {
          "bucket.$": "$.extractedDataS3Bucket",
          "key.$": "States.Format('{}{}/0/standard_output/0/result.json', $.extractedDataS3KeyPrefix, $.bedrockInvocationId)",
          "fieldPath": "document.representation.markdown"
        }
      },
      "ResultSelector": {
        "content.$": "$.Payload"
      },
      "ResultPath": "$.standardOutput",
      "Next": "PrepareAnalysisInput",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "EmitFailedEvent"
        }
      ]
    },
    "PrepareAnalysisInput": {
      "Type": "Pass",
      "Parameters": {
        "bucket.$": "$.bucket",
        "key.$": "$.key",
        "object.$": "$.object",
        "config.$": "$.config",
        "classification.$": "$.classification",
        "classificationConfidence.$": "$.classificationConfidence",
        "totalPages.$": "$.totalPages",
        "classifiedPages.$": "$.classifiedPages",
        "dominantTypePages.$": "$.dominantTypePages",
        "pageBreakdown.$": "$.pageBreakdown",
        "documentSizeBytes.$": "$.documentSizeBytes",
        "bedrockInvocationArn.$": "$.bedrockInvocationArn",
        "bedrockInvocationId.$": "$.bedrockInvocationId",
        "extractedDataS3Bucket.$": "$.extractedDataS3Bucket",
        "extractedDataS3KeyPrefix.$": "$.extractedDataS3KeyPrefix",
        "applicantProfile.$": "$.applicantProfile",
        "bankStatementData.$": "$.customOutput.content",
        "bankStatementMarkdown.$": "$.standardOutput.content",
        "extractionContext": {
          "totalPages.$": "$.totalPages",
          "classifiedPages.$": "$.classifiedPages",
          "dominantTypePages.$": "$.dominantTypePages",
          "pageBreakdown.$": "$.pageBreakdown",
          "classificationConfidence.$": "$.classificationConfidence",
          "note": "Confidence is dominantTypePages / classifiedPages (UNCLASSIFIED pages are treated as noise, not counted). BDA splitter is enabled, so if multiple BANK_STATEMENT segments were detected this analysis covers the first matched segment. If totalPages is much larger than dominantTypePages, the upload contained other content alongside the bank statement (e.g. UNCLASSIFIED pages, an overdraft letter, an unrelated document, another bank statement). Surface multi-segment context in remarks so the caseworker can verify."
        }
      },
      "Next": "AnalyseWithAI"
    },
    "AnalyseWithAI": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:bedrockruntime:converse",
      "Parameters": {
        "ModelId": "${BEDROCK_PROMPT_VERSION_ARN}",
        "PromptVariables": {
          "applicant_profile": {
            "Text.$": "States.JsonToString($.applicantProfile)"
          },
          "bank_statement_data": {
            "Text.$": "States.JsonToString($.bankStatementData)"
          },
          "bank_statement_markdown": {
            "Text.$": "$.bankStatementMarkdown"
          },
          "extraction_context": {
            "Text.$": "States.JsonToString($.extractionContext)"
          }
        }
      },
      "ResultPath": "$.analysis.raw",
      "Next": "ParseAnalysis",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout",
            "Bedrock.InternalServerException",
            "Bedrock.ThrottlingException"
          ],
          "IntervalSeconds": 3,
          "BackoffRate": 2.0,
          "MaxAttempts": 4
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "EmitFailedEvent"
        }
      ]
    },
    "ParseAnalysis": {
      "Type": "Pass",
      "Parameters": {
        "bucket.$": "$.bucket",
        "key.$": "$.key",
        "object.$": "$.object",
        "config.$": "$.config",
        "classification.$": "$.classification",
        "bedrockInvocationArn.$": "$.bedrockInvocationArn",
        "applicantProfile.$": "$.applicantProfile",
        "bankStatementData.$": "$.bankStatementData",
        "analysis.$": "$.analysis.raw.Output.Message.Content[0].ToolUse.Input"
      },
      "Next": "EmitCompletedEvent"
    },
    "EmitCompletedEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Detail": {
              "bucket.$": "$.bucket",
              "key.$": "$.key",
              "object.$": "$.object",
              "config.$": "$.config",
              "classification.$": "$.classification",
              "bedrockInvocationArn.$": "$.bedrockInvocationArn",
              "applicantProfile.$": "$.applicantProfile",
              "analysis.$": "$.analysis",
              "status": "COMPLETED"
            },
            "DetailType": "DocumentProcessing-AnalysisCompleted",
            "Source": "custom.documentProcessing"
          }
        ]
      },
      "End": true
    },
    "EmitFailedEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Detail": {
              "bucket.$": "$.bucket",
              "key.$": "$.key",
              "config.$": "$.config",
              "error.$": "$.error",
              "status": "FAILED"
            },
            "DetailType": "DocumentProcessing-AnalysisFailed",
            "Source": "custom.documentProcessing"
          }
        ]
      },
      "End": true
    }
  }
}
