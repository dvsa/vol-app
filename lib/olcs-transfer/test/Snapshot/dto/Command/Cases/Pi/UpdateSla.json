          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Date"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "callUpLetterDate"
      },
      "decisionLetterSentDate": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Date"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "decisionLetterSentDate"
      },
      "id": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
