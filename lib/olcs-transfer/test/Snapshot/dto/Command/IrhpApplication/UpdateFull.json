{
  "routeName": "backend/irhp-application/full",
  "method": "PUT",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "checked": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Boolean"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "name": "checked"
      },
      "corCertificateNumber": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\StringLength",
                "options": {
                  "min": 0,
                  "max": 12,
                  "encoding": "UTF-8",
                  "length": 0
                }
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "corCertificateNumber"
      },
      "dateReceived": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Date"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "dateReceived"
      },
      "declaration": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\Between",
                "numeric": true,
                "options": {
                  "inclusive": true,
                  "min": 0,
                  "max": 1
                }
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "declaration"
      },
      "id": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "id"
      },
      "permitsRequired": {
        "class": "Dvsa\\Olcs\\Transfer\\Util\\ArrayInput",
        "arrayFilterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": []
        },
        "arrayValidatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "name": "permitsRequired"
      },
      "postData": {
        "class": "Dvsa\\Olcs\\Transfer\\Util\\ArrayInput",
        "arrayFilterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": []
        },
        "arrayValidatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "name": "postData"
      }
    }
  }
}
