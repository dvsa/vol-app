{
  "routeName": "backend/permits/queue-run-scoring",
  "method": "POST",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "deviation": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\I18n\\Validator\\IsFloat",
                "wrapper": {
                  "class": "Laminas\\Stdlib\\StringWrapper\\Intl"
                }
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "deviation"
      },
      "id": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "id"
      }
    }
  }
}
