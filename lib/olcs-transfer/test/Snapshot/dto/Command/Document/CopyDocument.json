{
  "routeName": "backend/document/copy",
  "method": "POST",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "ids": {
        "class": "Dvsa\\Olcs\\Transfer\\Util\\ArrayInput",
        "arrayFilterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": []
        },
        "arrayValidatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "ids"
      },
      "targetId": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\StringLength",
                "options": {
                  "min": 1,
                  "max": null,
                  "encoding": "UTF-8",
                  "length": 0
                }
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "targetId"
      },
      "type": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "application",
                  "busReg",
                  "case",
                  "irfoOrganisation",
                  "irhpApplication",
                  "licence",
                  "transportManager"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "type"
      }
    }
  }
}
