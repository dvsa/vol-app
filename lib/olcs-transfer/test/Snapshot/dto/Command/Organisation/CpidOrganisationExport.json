{
  "routeName": "backend/organisation/cpid",
  "method": "POST",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "cpid": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "op_cpid_central_government",
                  "op_cpid_local_government",
                  "op_cpid_public_corporation",
                  "op_cpid_default",
                  "op_cpid_all"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "cpid"
      }
    }
  }
}
