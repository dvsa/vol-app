{
  "routeName": "backend/messaging/messages/unread-count-by-licence-and-roles",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "licence": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "licence"
      },
      "roles": {
        "class": "Dvsa\\Olcs\\Transfer\\Util\\ArrayInput",
        "arrayFilterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Dvsa\\Olcs\\Transfer\\Filter\\FilterEmptyItems"
            },
            {
              "class": "Dvsa\\Olcs\\Transfer\\Filter\\UniqueItems"
            }
          ]
        },
        "arrayValidatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "internal-limited-read-only",
                  "internal-read-only",
                  "internal-case-worker",
                  "internal-admin",
                  "internal-irhp-admin",
                  "operator-tc",
                  "operator-admin",
                  "operator-user",
                  "operator-tm",
                  "partner-admin",
                  "partner-user",
                  "local-authority-admin",
                  "local-authority-user",
                  "system-admin"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "roles"
      }
    }
  }
}
