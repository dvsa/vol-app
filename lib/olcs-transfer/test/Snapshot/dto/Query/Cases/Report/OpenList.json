{
  "routeName": "backend/cases/report/open",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "applicationStatus": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            },
            {
              "class": "Laminas\\Filter\\StringToLower"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\ApplicationStatus"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "applicationStatus"
      },
      "caseType": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            },
            {
              "class": "Laminas\\Filter\\StringToLower"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\CaseType"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "caseType"
      },
      "licenceStatus": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\LicenceStatus"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "licenceStatus"
      },
      "limit": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  1,
                  10,
                  25,
                  50,
                  100
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "limit"
      },
      "page": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "page"
      },
      "trafficAreas": {
        "class": "Dvsa\\Olcs\\Transfer\\Util\\ArrayInput",
        "arrayFilterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Dvsa\\Olcs\\Transfer\\Filter\\UniqueItems"
            }
          ]
        },
        "arrayValidatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "B",
                  "C",
                  "D",
                  "F",
                  "G",
                  "H",
                  "K",
                  "M",
                  "N",
                  "all",
                  "other"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "trafficAreas"
      }
    }
  }
}
