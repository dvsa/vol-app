{
  "routeName": "backend/fee-type/fee-rates",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "feeType": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\StringLength",
                "options": {
                  "min": 1,
                  "max": 32,
                  "encoding": "UTF-8",
                  "length": 0
                }
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "feeType"
      },
      "goodsOrPsv": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "lcat_gv",
                  "lcat_psv",
                  "lcat_permit",
                  "NULL"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "goodsOrPsv"
      },
      "isFeeRateAdmin": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "name": "isFeeRateAdmin"
      },
      "limit": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  1,
                  10,
                  25,
                  50,
                  100
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "limit"
      },
      "order": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            },
            {
              "class": "Laminas\\Filter\\StringToUpper"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\Order"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "order"
      },
      "page": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\Digits"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Digits"
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Laminas\\Validator\\GreaterThan",
                "min": 0,
                "inclusive": false
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "page"
      },
      "sort": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\NotEmpty",
                "options": {
                  "type": 489
                }
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\Sort"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "sort"
      },
      "sortWhitelist": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "name": "sortWhitelist"
      }
    }
  }
}
