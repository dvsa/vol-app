{
  "routeName": "backend/fee/interim-refunds",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "endDate": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Date"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "endDate"
      },
      "order": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            },
            {
              "class": "Laminas\\Filter\\StringToUpper"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\Order"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "order"
      },
      "sort": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\NotEmpty",
                "options": {
                  "type": 489
                }
              },
              "breakChainOnFailure": false
            },
            {
              "instance": {
                "class": "Dvsa\\Olcs\\Transfer\\Validators\\Sort"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "sort"
      },
      "sortWhitelist": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "name": "sortWhitelist"
      },
      "startDate": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Date"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "startDate"
      },
      "trafficAreas": {
        "class": "Dvsa\\Olcs\\Transfer\\Util\\ArrayInput",
        "arrayFilterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Dvsa\\Olcs\\Transfer\\Filter\\UniqueItems"
            }
          ]
        },
        "arrayValidatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": []
        },
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "B",
                  "C",
                  "D",
                  "F",
                  "G",
                  "H",
                  "K",
                  "M",
                  "N",
                  "all"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "trafficAreas"
      }
    }
  }
}
