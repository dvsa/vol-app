{
  "routeName": "backend/fee-type/latest",
  "inputFilter": {
    "class": "Laminas\\InputFilter\\InputFilter",
    "inputs": {
      "date": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\Date"
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "date"
      },
      "feeType": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\StringLength",
                "options": {
                  "min": 1,
                  "max": 32,
                  "encoding": "UTF-8",
                  "length": 0
                }
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "feeType"
      },
      "licenceType": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "ltyp_r",
                  "ltyp_sn",
                  "ltyp_si",
                  "ltyp_sr"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "licenceType"
      },
      "operatorType": {
        "class": "Laminas\\InputFilter\\Input",
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "lcat_gv",
                  "lcat_psv"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "operatorType"
      },
      "trafficArea": {
        "class": "Laminas\\InputFilter\\Input",
        "allowEmpty": true,
        "filterChain": {
          "class": "Laminas\\Filter\\FilterChain",
          "filters": [
            {
              "class": "Laminas\\Filter\\StripTags"
            },
            {
              "class": "Laminas\\Filter\\StringTrim"
            }
          ]
        },
        "required": false,
        "validatorChain": {
          "class": "Laminas\\Validator\\ValidatorChain",
          "validators": [
            {
              "instance": {
                "class": "Laminas\\Validator\\InArray",
                "haystack": [
                  "B",
                  "C",
                  "D",
                  "F",
                  "G",
                  "H",
                  "K",
                  "M",
                  "N"
                ]
              },
              "breakChainOnFailure": false
            }
          ]
        },
        "name": "trafficArea"
      }
    }
  }
}
