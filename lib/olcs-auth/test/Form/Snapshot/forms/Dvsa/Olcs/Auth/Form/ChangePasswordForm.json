{
  "name": "change-password-form",
  "attributes": {
    "method": "post"
  },
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "oldPassword",
        "options": {
          "label": "auth.change-password.old-password",
          "short-label": "auth.change-password.old-password",
          "error-message": "auth.change-password.old-password.error"
        },
        "attributes": {
          "id": "auth.change-password.old-password"
        },
        "type": "Password"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "newPassword",
        "options": {
          "label": "auth.change-password.new-password",
          "short-label": "auth.change-password.new-password"
        },
        "attributes": {
          "id": "auth.change-password.new-password"
        },
        "type": "Password"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "confirmPassword",
        "options": {
          "label": "auth.change-password.confirm-password",
          "short-label": "auth.change-password.confirm-password",
          "error-message": "auth.change-password.confirm-password.error"
        },
        "attributes": {
          "id": "auth.change-password.confirm-password"
        },
        "type": "Password"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "submit",
        "attributes": {
          "id": "auth.change-password.button",
          "value": "auth.change-password.button",
          "class": "govuk-button"
        },
        "type": "Submit"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "cancel",
        "attributes": {
          "data-module": "govuk-button",
          "type": "submit",
          "class": "govuk-button govuk-button--secondary",
          "id": "cancel"
        },
        "options": {
          "label": "cancel.button"
        },
        "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
      }
    }
  ],
  "fieldsets": [],
  "input_filter": {
    "oldPassword": {
      "name": "oldPassword",
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ]
    },
    "newPassword": {
      "name": "newPassword",
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\StringLength",
          "options": {
            "min": 12,
            "max": 160
          }
        },
        {
          "name": "Common\\Form\\Elements\\Validators\\PasswordConfirm",
          "options": {
            "token": "confirmPassword"
          }
        }
      ]
    },
    "confirmPassword": {
      "name": "confirmPassword",
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ]
    }
  }
}
