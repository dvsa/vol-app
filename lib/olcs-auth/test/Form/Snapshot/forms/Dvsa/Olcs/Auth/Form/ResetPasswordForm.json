{
  "name": "reset-password-form",
  "attributes": {
    "method": "post"
  },
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "newPassword",
        "options": {
          "label": "auth.reset-password.new-password",
          "short-label": "auth.reset-password.new-password",
          "shouldEscapeMessages": false
        },
        "attributes": {
          "id": "auth.reset-password.new-password"
        },
        "type": "Password"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "confirmPassword",
        "options": {
          "label": "auth.reset-password.confirm-password",
          "short-label": "auth.reset-password.confirm-password"
        },
        "attributes": {
          "id": "auth.reset-password.confirm-password"
        },
        "type": "Password"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "submit",
        "attributes": {
          "id": "auth.reset-password.button",
          "value": "auth.reset-password.button",
          "class": "govuk-button"
        },
        "type": "Submit"
      }
    }
  ],
  "fieldsets": [],
  "input_filter": {
    "newPassword": {
      "name": "newPassword",
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\StringLength",
          "options": {
            "min": 12
          }
        },
        {
          "name": "Laminas\\Validator\\Regex",
          "options": {
            "pattern": "/^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{12,}$/",
            "message": "auth.expired-password.failed.reason.New password does not meet the password policy requirements."
          }
        }
      ]
    },
    "confirmPassword": {
      "name": "confirmPassword",
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\Identical",
          "options": {
            "token": "newPassword"
          }
        },
        {
          "name": "Laminas\\Validator\\StringLength",
          "options": {
            "min": 12
          }
        }
      ]
    }
  }
}
