{
  "name": "olcs/vol-logging-mvc",
  "description": "Laminas MVC bindings for olcs-logging",
  "license": "MIT",
  "version": "1.0.0",
  "repositories": [
    {
      "type": "path",
      "url": "../olcs-logging",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "~8.4.0",
    "olcs/olcs-logging": "^9",
    "laminas/laminas-eventmanager": "^3.14",
    "laminas/laminas-http": "^2.22",
    "laminas/laminas-mvc": "^3.8",
    "laminas/laminas-servicemanager": "^3.23",
    "psr/container": "^1.1|^2",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Olcs\\Logging\\Mvc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OlcsTest\\Logging\\Mvc\\": "test/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "mockery/mockery": "^1.6",
    "bamarni/composer-bin-plugin": "^1.8.2",
    "phpstan/phpstan-mockery": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "scripts": {
    "bin": "echo 'bin not installed'",
    "post-install-cmd": [
      "@composer bin all install"
    ],
    "test": "phpunit",
    "phpcs": "phpcs",
    "psalm": "psalm",
    "phpstan": "phpstan --memory-limit=1G",
    "all": [
      "@test",
      "@phpcs",
      "@psalm",
      "@phpstan"
    ]
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true
    }
  }
}
