<div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
    <div class="govuk-radios__item">
        <input id="table-radio-{{id}}" class="govuk-radios__input" type="radio" name="id" value="{{id}}" />
        <label class="govuk-label govuk-radios__label" for="table-radio-{{id}}">
            <span class="govuk-visually-hidden">Select row</span>
        </label>
    </div>

</div>