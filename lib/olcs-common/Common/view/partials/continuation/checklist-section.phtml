<table class="govuk-table checklist-table">
  <tbody class="govuk-table__body">
  <?php foreach ($this->data as $line) : ?>
    <tr class="govuk-table__row">
      <?php foreach ($line as $key => $cell) :
        $isLast = $key === (count($line) - 1) && count($line) !== 1;
        $class = 'govuk-table__cell' . ($isLast ? ' td--right-aligned' : '');
        if (isset($cell['header']) && $cell['header']) : ?>
          <th class="govuk-table__header <?php echo $class; ?>"><h4><?php echo $cell['value']; ?></h4></th>
        <?php else : ?>
          <td class="<?php echo $class; ?>"><?php echo $cell['value']; ?></td>
        <?php endif;
      endforeach; ?>
    </tr>
  <?php endforeach; ?>
  </tbody>
</table>
