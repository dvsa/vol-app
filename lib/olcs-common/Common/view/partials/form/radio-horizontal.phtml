<?php
/** @var Common\Form\Elements\Types\RadioHorizontal $element */
$element = $this->element;

/** @var \Laminas\Form\Element\Radio $radioElement */
$radioElement = $element->get('yesNo');
$errors = $this->formElementErrors()->render($radioElement);
$hasValidationError = !empty($errors);
$hintId = ($element->getAttribute('id') ?: $element->getName()) . '-hint';
$descriptionIds = preg_split(
    '/\s+/',
    trim(($element->getAttribute('aria-describedby') ?? '') . ' ' . ($radioElement->getAttribute('aria-describedby') ?? '')),
    -1,
    PREG_SPLIT_NO_EMPTY
) ?: [];
if ($element->getOption('hint')) {
    $descriptionIds[] = $hintId;
}
if ($hasValidationError) {
    $descriptionIds[] = $this->formElementErrors()->getErrorId($radioElement);
}
$describedBy = implode(' ', array_unique($descriptionIds));
if ($describedBy !== '') {
    $radioElement->setAttribute('aria-describedby', $describedBy);
}
?>

<div class="<?php echo ($hasValidationError) ? 'field error__wrapper' : 'field' ?>">
    <fieldset class="radio-button__fieldset radio-button__fieldset--horizontal"<?php if ($describedBy !== '') : ?> aria-describedby="<?php echo $this->escapeHtmlAttr($describedBy); ?>"<?php endif; ?>>
        <legend><?php echo $this->translate($element->getLabel()) ?></legend>

        <?php if ($element->getOption('hint')) : ?>
            <p id="<?php echo $this->escapeHtmlAttr($hintId); ?>" class="form-hint"><?php echo $this->translate($element->getOption('hint')) ?></p>
        <?php endif; ?>

        <?php if ($hasValidationError) : ?>
            <?php echo $errors ?>
        <?php endif; ?>

        <?php
        $radioElement = clone $radioElement;
        $valueOptions = $radioElement->getValueOptions();
        foreach (['Y' => 'yesContent', 'N' => 'noContent'] as $key => $contentName) {
            if ($element->has($contentName)) {
                $valueOption = $valueOptions[$key];
                if (is_scalar($valueOption)) {
                    $valueOption = ['value' => $key, 'label' => $valueOption];
                }
                $valueOption['conditional_content'] = $valueOption['conditional_content'] ?? $element->get($contentName);
                $valueOptions[$key] = $valueOption;
            }
        }
        $radioElement->setValueOptions($valueOptions);
        $wrapperAttributes = $radioElement->getAttribute('radios_wrapper_attributes') ?? [];
        $wrapperAttributes['class'] = trim(($wrapperAttributes['class'] ?? '') . ' govuk-radios--inline');
        $radioElement->setAttribute('radios_wrapper_attributes', $wrapperAttributes);
        echo $this->formRadio($radioElement);
        ?>
    </fieldset>
</div>
