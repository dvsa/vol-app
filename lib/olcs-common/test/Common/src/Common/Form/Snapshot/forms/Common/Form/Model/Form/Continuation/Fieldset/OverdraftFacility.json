{
  "name": "OverdraftFacility",
  "attributes": [],
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "yesNo",
        "type": "Common\\Form\\Elements\\Types\\RadioYesNo",
        "options": {
          "label": "continuations.finances.overdraftFacility.label"
        }
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "yesContent",
        "type": "Text",
        "attributes": {
          "id": "overDraftLimit",
          "required": "required"
        },
        "options": {
          "label": "continuations.finances.overdraftFacility.amount.label"
        }
      }
    }
  ],
  "fieldsets": [],
  "type": "\\Common\\Form\\Elements\\Types\\RadioHorizontal",
  "options": {
    "label": "continuations.finances.overdraftFacility.label"
  },
  "input_filter": {
    "yesNo": {
      "name": "yesNo",
      "error_message": "continuations.finances.overdraftFacility.error"
    },
    "yesContent": {
      "name": "yesContent",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "null"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
