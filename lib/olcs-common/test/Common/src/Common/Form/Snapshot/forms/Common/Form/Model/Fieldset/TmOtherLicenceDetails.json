        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\StringLength",
          "options": {
            "max": 255
          }
        }
      ]
    },
    "totalAuthVehicles": {
      "name": "totalAuthVehicles",
      "required": false,
      "validators": [
        {
          "name": "Digits"
        }
      ]
    },
    "hoursPerWeek": {
      "name": "hoursPerWeek",
      "validators": [
        {
          "name": "Laminas\\Validator\\LessThan",
          "options": {
            "max": 99.9,
            "inclusive": true
          }
        },
        {
          "name": "Laminas\\I18n\\Validator\\IsFloat",
          "options": {
            "allow_empty": false,
            "messages": {
              "notFloat": "transport-manager.other-licence.form.hours-per-week.error_msg"
            }
          }
        }
      ]
    }
