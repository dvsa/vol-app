  "fieldsets": [],
  "input_filter": {
    "licNo": {
      "name": "licNo",
      "required": true,
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\StringLength",
          "options": {
            "max": 18
          }
        }
      ]
    },
    "role": {
      "name": "role",
      "required": false
    },
