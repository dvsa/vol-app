              "name": "requiredFinance",
              "type": "\\Common\\Form\\Elements\\Types\\HtmlTranslated"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "evidence",
        "attributes": {
          "class": "last"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "uploadedFileCount",
              "options": {
                "fieldset-attributes": {
                  "id": "files"
                }
              },
              "attributes": {
                "required": false,
                "id": "uploadedFileCount"
              },
              "type": "Hidden"
