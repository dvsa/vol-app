  },
  "input_filter": {
    "adPlacedIn": {
      "name": "adPlacedIn",
      "required": false
    },
    "adPlacedDate": {
      "name": "adPlacedDate",
      "required": false,
      "filters": [
        {
          "name": "DateSelectNullifier"
        }
      ],
      "validators": [
        {
          "name": "\\Common\\Validator\\Date"
        },
        {
          "name": "Date",
          "options": {
            "format": "Y-m-d"
