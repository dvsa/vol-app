  "options": {
    "prefer_form_input_filter": true
  },
  "type": "Common\\Form\\Form",
  "input_filter": {
    "address": {
      "searchPostcode": {
        "name": "searchPostcode",
        "required": false
      },
      "addressLine1": {
        "name": "addressLine1",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 0,
              "max": 90
            }
          }
        ]
      },
      "addressLine2": {
        "name": "addressLine2",
        "required": false,
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 0,
              "max": 90
            }
          }
        ]
      },
      "addressLine3": {
        "name": "addressLine3",
        "required": false,
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 0,
              "max": 100
            }
          }
        ]
      },
      "addressLine4": {
        "name": "addressLine4",
        "required": false,
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 0,
              "max": 35
            }
          }
        ]
      },
      "town": {
        "name": "town",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 0,
              "max": 30
            }
          }
        ]
      },
      "postcode": {
        "name": "postcode",
        "required": true,
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "Dvsa\\Olcs\\Transfer\\Validators\\Postcode"
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    },
    "data": {
      "noOfVehiclesRequired": {
        "name": "noOfVehiclesRequired",
        "validators": [
          {
            "name": "Between",
            "options": {
              "min": 0,
              "max": 1000000
            }
          }
        ]
      },
      "noOfTrailersRequired": {
        "name": "noOfTrailersRequired",
        "validators": [
          {
            "name": "Between",
            "options": {
              "min": 0,
              "max": 1000000
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    },
    "advertisements": {
      "radio": {
        "name": "radio",
        "error_message": "advertisements_adPlaced-error"
      },
      "adPlacedContent": {
        "adPlacedIn": {
          "name": "adPlacedIn",
          "required": false
        },
        "adPlacedDate": {
          "name": "adPlacedDate",
          "required": false,
          "filters": [
            {
              "name": "DateSelectNullifier"
            }
          ],
          "validators": [
            {
              "name": "\\Common\\Validator\\Date"
            },
            {
              "name": "Date",
              "options": {
                "format": "Y-m-d"
              }
            }
          ]
        },
        "file": {
          "fileCount": {
            "name": "fileCount",
            "required": false,
            "validators": [
              {
                "name": "Laminas\\Validator\\NotEmpty",
                "options": [
                  "null"
                ]
              },
              {
                "name": "Common\\Validator\\FileUploadCountV2",
                "options": {
                  "min": 1
                }
              }
            ]
          },
          "type": "Laminas\\InputFilter\\InputFilter"
        },
        "type": "Laminas\\InputFilter\\InputFilter"
      },
      "uploadedFileCount": {
        "name": "uploadedFileCount",
        "allow_empty": true,
        "type": "Common\\InputFilter\\ContinueIfEmptyInput",
        "required": true,
        "validators": [
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "radio",
              "context_values": [
                "adPlaced"
              ],
              "validators": [
                {
                  "name": "\\Common\\Validator\\FileUploadCount",
                  "options": {
                    "min": 1,
                    "message": "ERR_OC_AD_FI_1"
                  }
                }
              ]
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
