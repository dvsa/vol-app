            "compare_to_label": "Start date"
          }
        },
        {
          "name": "Dvsa\\Olcs\\Transfer\\Validators\\DateInFuture",
          "options": {
            "include_today": true,
            "use_time": false,
            "allow_empty": true
          }
        }
