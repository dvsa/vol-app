{
  "name": "community-licences-edit-suspension-dates",
  "attributes": {
    "id": "dates"
  },
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "startDate",
        "attributes": {
          "required": "required"
        },
        "options": {
          "label": "internal.community_licence.form.start_date",
          "create_empty_option": true,
          "render_delimiters": false
        },
        "type": "DateSelect"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "endDate",
        "options": {
          "label": "internal.community_licence.form.end_date",
          "create_empty_option": true,
          "render_delimiters": false
        },
        "type": "DateSelect"
      }
    }
  ],
  "fieldsets": [],
  "input_filter": {
    "startDate": {
      "name": "startDate",
      "required": true,
      "filters": [
        {
          "name": "DateSelectNullifier"
        }
      ],
      "validators": [
        {
          "name": "\\Common\\Validator\\Date"
        },
        {
