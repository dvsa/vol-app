        {
          "name": "Dvsa\\Olcs\\Transfer\\Validators\\DateInFuture",
          "options": {
            "include_today": true,
            "use_time": false
          }
        }
      ]
    },
    "endDate": {
      "name": "endDate",
      "required": false,
      "filters": [
        {
          "name": "DateSelectNullifier"
        }
      ],
      "validators": [
        {
          "name": "\\Common\\Validator\\Date"
        },
        {
          "name": "Date",
          "options": {
            "format": "Y-m-d"
          }
        },
        {
          "name": "DateCompare",
          "options": {
            "has_time": false,
            "allow_empty": true,
