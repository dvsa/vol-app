# Snyk policy file for the documentation site (scanned by the Documentation job in
# .github/workflows/security-documentation.yaml).
#
# Only for advisories with no fixed release anywhere, or whose fixed release cannot be loaded
# by the package that depends on it. Anything that can be resolved by moving a version is
# resolved instead - by npm audit fix, by bumping Docusaurus, or by an entry in the
# "overrides" block of package.json. An exclusion here is the last resort, not the first.
#
# Snyk applies this file to the project sharing its directory, so website/.snyk covers
# website/package.json. If an ignore ever appears not to take effect, pass the documented
# fallback --policy-path=website on the snyk test command.
version: v1.25.0
ignore:
  # uri-js, percent-decoding and removeDotSegments infinite loop, and an uncaught exception on
  # malformed input. 4.4.1 is the final release of an unmaintained package and all three affect
  # it. Reached only through ajv 6 inside schema-utils 3, which file-loader, url-loader and
  # null-loader use to validate their own webpack options -
  # options written by Docusaurus and this repo's config, never a URI from outside. ajv 8 has
  # moved off uri-js; this goes away when Docusaurus drops the schema-utils 3 loaders.
  SNYK-JS-URIJS-19963961:
    - "*":
        reason: >-
          No fixed release exists - uri-js is unmaintained. Build-time only, via ajv 6 validating
          webpack loader options that come from Docusaurus and this repo's config.
        expires: 2026-11-25T00:00:00.000Z
  SNYK-JS-URIJS-19963963:
    - "*":
        reason: >-
          No fixed release exists - uri-js is unmaintained. Build-time only, via ajv 6 validating
          webpack loader options that come from Docusaurus and this repo's config.
        expires: 2026-11-25T00:00:00.000Z
  SNYK-JS-URIJS-20341609:
    - "*":
        reason: >-
          No fixed release exists - uri-js is unmaintained. Build-time only, via ajv 6 validating
          webpack loader options that come from Docusaurus and this repo's config.
        expires: 2026-11-25T00:00:00.000Z
  # http-cache-semantics, two shared-cache flaws that serve one client's cached response to
  # another. 4.3.0 (now in the lockfile) fixes the Vary: * flaw (19964064) but Snyk still lists
  # every version as affected, and nothing yet fixes the max-stale flaw (19964068). Drop 19964064
  # once Snyk records 4.3.0 as the fix. Reached only through update-notifier, which
  # asks the npm registry whether a newer Docusaurus exists when the CLI runs; there is one
  # client and no shared cache, so there is nobody else's response to leak.
  SNYK-JS-HTTPCACHESEMANTICS-19964068:
    - "*":
        reason: >-
          No fixed release exists. Build-time only, via Docusaurus's update-notifier - a single
          client checking the npm registry, with no shared cache to leak between users.
        expires: 2026-11-25T00:00:00.000Z
  SNYK-JS-HTTPCACHESEMANTICS-19964064:
    - "*":
        reason: >-
          No fixed release exists. Build-time only, via Docusaurus's update-notifier - a single
          client checking the npm registry, with no shared cache to leak between users.
        expires: 2026-11-25T00:00:00.000Z
  # braces, stack exhaustion on deeply nested brace patterns. 3.0.3 is the latest release and is
  # affected. Reached through micromatch/fast-glob while Docusaurus globs this repo's docs, and
  # the patterns are Docusaurus's and this repo's own - the worst case is a failed build.
  SNYK-JS-BRACES-19963945:
    - "*":
        reason: >-
          No fixed release exists. Build-time only - the glob patterns come from Docusaurus and
          this repo's config, and the worst outcome is a crashed build.
        expires: 2026-11-25T00:00:00.000Z
  # flat, unbounded sparse-array allocation in unflatten() on keys like a.4294967294. Every
  # release is affected (6.0.1 is the latest). Reached only through webpack-merge (5.x under
  # @docusaurus/types, 6.x under @docusaurus/core), which calls flatten() - never unflatten() -
  # on webpack config objects written by Docusaurus and this repo.
  SNYK-JS-FLAT-22148819:
    - "*":
        reason: >-
          No fixed release exists. Build-time only, via webpack-merge, which never calls the
          vulnerable unflatten() and only sees webpack config from Docusaurus and this repo.
        expires: 2026-12-05T00:00:00.000Z
  # minimatch, CPU/memory amplification in firstPhasePreProcess under optimizationLevel >= 2.
  # The fix is in 11.0.1, but the only 3.x consumer, serve-handler 6.1.7 (latest), calls
  # require('minimatch') as a function, which 9.x+ no longer exports - an override would break
  # `docusaurus serve`. 3.1.5 also predates both firstPhasePreProcess and optimizationLevel, so
  # the vulnerable code is not present; Snyk's <11.0.1 range is wider than the flaw. The patterns
  # are serve-handler's rewrite/header config from Docusaurus, never request input.
  SNYK-JS-MINIMATCH-22111072:
    - "*":
        reason: >-
          The fixed 11.x cannot be loaded by serve-handler, the only consumer, and 3.1.5 does not
          contain the vulnerable firstPhasePreProcess/optimizationLevel code. Local preview only.
        expires: 2026-12-05T00:00:00.000Z
patch: {}
