{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "start": "npm run clean && docmd dev",
    "build": "npm run clean && docmd build",
    "serve": "npm run clean && docmd serve",
    "validate": "docmd validate"
  },
  "dependencies": {
    "@docmd/core": "0.10.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
