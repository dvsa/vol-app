{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/react": "^18.2.29",
    "typescript": "~5.7.2"
  },
  "//overrides": [
    "Build-time advisories that Docusaurus pins below their fixed release: serialize-javascript",
    "(RCE/DoS, held at 6.x by copy-webpack-plugin and css-minimizer-webpack-plugin) and uuid",
    "(bounds check, held at 8.x by sockjs under webpack-dev-server). Forcing the fixed version",
    "is cheaper than carrying a scan exception. Drop an entry once Docusaurus resolves it itself.",
    "image-size has no entry because no released version fixes it - overriding cannot help, so",
    "it is excluded in .snyk instead, which is reserved for exactly that case."
  ],
  "overrides": {
    "serialize-javascript": "^7.1.0",
    "sockjs": {
      "uuid": "^11.1.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
