<?php

use Dvsa\Olcs\Utils\Development\ConfigCacheKey;

// Development toggles come from environment variables that compose.yaml passes in from the root .env
// file. See docs/app/local-setup.
$isEnabled = static fn (string $name): bool => filter_var(getenv($name), FILTER_VALIDATE_BOOLEAN);

// Merging the configuration is the slowest part of a request, so the result is cached. The cache
// is named after the files the configuration is built from and the container, so it's rebuilt when
// one of those files changes or the container is recreated, which is how a change to .env arrives.
// Command-line runs don't cache: container-cli.php gives them fixed cache names.
$cacheConfig = PHP_SAPI !== 'cli' && $isEnabled('VOL_CONFIG_CACHE');
$cacheKey = $cacheConfig ? ConfigCacheKey::forApplication(dirname(__DIR__))->key() : 'development';

return [
  // Additional modules to include when in development mode
  'modules' => [
  ],
  // Configuration overrides during development mode
  'module_listener_options' => [
    'config_glob_paths' => [realpath(__DIR__) . '/autoload/{,*.}{global,local}-development.php'],
    'config_cache_enabled' => $cacheConfig,
    'module_map_cache_enabled' => $cacheConfig,
    'config_cache_key' => $cacheKey,
    'module_map_cache_key' => $cacheKey,
  ],
];
