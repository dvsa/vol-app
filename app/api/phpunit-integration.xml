<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="test/integration/bootstrap.php"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnSkippedTests="true"
>
  <php>
    <ini name="date.timezone" value="UTC"/>
    <ini name="memory_limit" value="2G"/>
  </php>
  <extensions>
    <!-- Reports the Doctrine deprecations this suite triggers; see the class for why the
         DOCTRINE_DEPRECATIONS env var cannot do this. -->
    <bootstrap class="Dvsa\OlcsTest\Integration\Support\DoctrineDeprecations"/>
  </extensions>
  <testsuites>
    <testsuite name="Integration">
      <directory>./test/integration/src</directory>
    </testsuite>
  </testsuites>
</phpunit>
