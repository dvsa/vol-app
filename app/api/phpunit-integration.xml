<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="test/integration/bootstrap.php"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnSkippedTests="true"
>
  <php>
    <ini name="date.timezone" value="UTC"/>
    <ini name="memory_limit" value="2G"/>
    <!--
      Doctrine deprecations are silent by default (doctrine/deprecations ships with
      TYPE_NONE unless DOCTRINE_DEPRECATIONS is set). This is the only suite where real
      Doctrine runs against real metadata, so it is the only place they can surface.
      Reported, not fatal: displayDetailsOnTestsThatTriggerDeprecations above prints them
      and there is no failOnDeprecation here, so they read as advance notice of the next
      major rather than a broken build.
    -->
    <env name="DOCTRINE_DEPRECATIONS" value="trigger"/>
  </php>
  <testsuites>
    <testsuite name="Integration">
      <directory>./test/integration/src</directory>
    </testsuite>
  </testsuites>
</phpunit>
