        "-100 Laminas\\Mvc\\View\\Http\\InjectViewModelListener::injectViewModel",
        "-10000 Laminas\\Mvc\\View\\Http\\DefaultRenderingStrategy::render"
      ],
      "route": [
        "10000 Laminas\\Mvc\\HttpMethodListener::onRoute",
        "10000 Olcs\\Logging\\Mvc\\Listener\\LogRequest::onRoute",
        "1 Laminas\\Mvc\\RouteListener::onRoute",
        "1 Laminas\\Mvc\\ModuleRouteListener::onRoute",
        "1 Dvsa\\Olcs\\Api\\Mvc\\PayloadValidationListener::onRoute"
      ]
    }
  },
  "send response": {
    "identifiers": [
      "Laminas\\Mvc\\SendResponseListener"
    ],
    "events": {
      "sendResponse": [
        "1 {closure:Dvsa\\Olcs\\Api\\Module::onBootstrap()}",
