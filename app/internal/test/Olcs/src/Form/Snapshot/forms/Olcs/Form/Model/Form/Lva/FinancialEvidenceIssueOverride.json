{
  "name": "financial-evidence-issue-override",
  "attributes": {
    "method": "post"
  },
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "analysisId",
        "type": "Hidden",
        "attributes": {
          "required": "required"
        }
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "row",
        "type": "Hidden",
        "attributes": {
          "required": "required"
        }
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "changeRecommendation",
        "attributes": {
          "required": "required",
          "radios_wrapper_attributes": {
            "class": "govuk-radios--standard govuk-radios--inline"
          }
        },
        "type": "Radio",
        "options": {
          "label": "Change this recommendation to a pass?",
          "value_options": {
            "N": "No",
            "Y": "Yes"
          },
          "fieldset-attributes": {
            "class": "govuk-fieldset"
          },
          "legend-attributes": {
            "class": "govuk-fieldset__legend govuk-fieldset__legend--s"
          }
        }
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "comment",
        "attributes": {
          "required": false,
          "class": "extra-long"
        },
        "type": "TextArea",
        "options": {
          "label": "Reason for the change"
        }
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "saveOverride",
        "attributes": {
          "data-module": "govuk-button",
          "type": "submit",
          "class": "govuk-button",
          "value": "override"
        },
        "options": {
          "label": "Save and continue"
        },
        "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
      }
    }
  ],
  "fieldsets": [],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true
  },
  "input_filter": {
    "analysisId": {
      "name": "analysisId",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\Digits"
        }
      ]
    },
    "row": {
      "name": "row",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\InArray",
          "options": {
            "haystack": [
              "authenticity",
              "name",
              "statementDate",
              "statementPeriod",
              "averageFunds",
              "largeDeposit"
            ],
            "strict": true
          }
        }
      ]
    },
    "changeRecommendation": {
      "name": "changeRecommendation",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": {
            "messages": {
              "isEmpty": "Select yes if you want to change this recommendation to a pass"
            }
          }
        }
      ]
    },
    "comment": {
      "name": "comment",
      "required": true,
      "filters": [
        {
          "name": "Laminas\\Filter\\StringTrim"
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "null"
          ]
        },
        {
          "name": "Laminas\\Validator\\StringLength",
          "options": {
            "max": 1000,
            "messages": {
              "stringLengthTooLong": "Reason for the change must be 1,000 characters or fewer"
            }
          }
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "changeRecommendation",
            "context_values": [
              "Y"
            ],
            "allow_empty": false,
            "validators": [
              {
                "name": "Laminas\\Validator\\NotEmpty",
                "options": {
                  "messages": {
                    "isEmpty": "Enter a reason for changing the recommendation"
                  }
                },
                "break_chain_on_failure": true
              }
            ]
          }
        }
      ]
    }
  }
}
