  "input_filter": {
    "paymentType": {
      "name": "paymentType",
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty"
        }
      ]
    },
    "received": {
      "name": "received",
      "validators": [
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_card_offline"
            ],
            "context_truth": false,
            "allow_empty": false,
            "validators": [
              {
                "name": "Laminas\\Validator\\GreaterThan",
                "options": {
                  "min": 0,
                  "messages": {
                    "notGreaterThan": "The payment amount must be greater than %min%"
                  }
                },
                "break_chain_on_failure": true
              },
              {
                "name": "\\Common\\Form\\Elements\\Validators\\ReceivedAmount"
              }
            ]
          }
        }
      ]
    },
    "receiptDate": {
      "name": "receiptDate",
      "required": true,
      "filters": [
        {
          "name": "DateSelect",
          "options": {
            "null_on_empty": true
          }
        }
      ],
      "validators": [
        {
          "name": "NotEmpty",
          "options": [
            "array"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_card_offline"
            ],
            "context_truth": false,
            "allow_empty": false,
            "validators": [
              {
                "name": "NotEmpty"
              },
              {
                "name": "\\Common\\Validator\\Date"
              },
              {
                "name": "Date",
                "options": {
                  "format": "Y-m-d"
                }
              },
              {
                "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture"
              }
            ]
          }
        }
      ]
    },
    "payer": {
      "name": "payer",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "null"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_card_offline"
            ],
            "context_truth": false,
            "allow_empty": false,
            "validators": [
              {
                "name": "Laminas\\Validator\\NotEmpty"
              }
            ]
          }
        }
      ]
    },
    "slipNo": {
      "name": "slipNo",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "null"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_card_offline"
            ],
            "context_truth": false,
            "allow_empty": false,
            "validators": [
              {
                "name": "Digits",
                "options": {
                  "messages": {
                    "digitsStringEmpty": "value is required"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "chequeNo": {
      "name": "chequeNo",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "null"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_cheque"
            ],
            "allow_empty": false,
            "validators": [
              {
                "name": "Laminas\\Validator\\NotEmpty"
              }
            ]
          }
        }
      ]
    },
    "chequeDate": {
      "name": "chequeDate",
      "required": true,
      "filters": [
        {
          "name": "DateSelect",
          "options": {
            "null_on_empty": true
          }
        }
      ],
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "array"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_cheque"
            ],
            "context_truth": true,
            "allow_empty": false,
            "validators": [
              {
                "name": "NotEmpty"
              },
              {
                "name": "\\Common\\Validator\\Date"
              },
              {
                "name": "Date",
                "options": {
                  "format": "Y-m-d"
                }
              },
              {
                "name": "\\Common\\Form\\Elements\\Validators\\ChequeDate"
              },
              {
                "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture",
                "options": {
                  "messageTemplates": {
                    "inFuture": "Cheque date cannot be in the future"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "poNo": {
      "name": "poNo",
      "required": true,
      "validators": [
        {
          "name": "Laminas\\Validator\\NotEmpty",
          "options": [
            "null"
          ]
        },
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "paymentType",
            "context_values": [
              "fpm_po"
            ],
            "allow_empty": false,
            "validators": [
              {
                "name": "Digits",
                "options": {
                  "messages": {
                    "digitsStringEmpty": "value is required"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "customerReference": {
      "name": "customerReference",
      "required": true
    },
    "customerName": {
      "name": "customerName",
      "required": true
    }
  }
}
