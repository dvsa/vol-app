        "options": {
          "label": "First name"
        },
        "type": "Text"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "familyName",
        "attributes": {
          "placeholder": "",
          "class": "medium"
        },
        "options": {
          "label": "Last name"
        },
        "type": "Text"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "birthDate",
        "attributes": {
          "id": "birthDate"
        },
        "options": {
          "label": "Birth date",
          "create_empty_option": true,
          "render_delimiters": false
