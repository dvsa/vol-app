{
  "name": "licence-decision-curtail",
  "attributes": [],
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "curtailFrom",
        "type": "DateTimeSelect",
        "attributes": {
          "required": false
        },
        "options": {
          "label": "licence-status.curtailment.from",
          "create_empty_option": true,
          "max_year_delta": "+10",
          "min_year_delta": "-5"
        }
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "curtailTo",
        "type": "DateTimeSelect",
        "options": {
          "label": "licence-status.curtailment.to",
          "create_empty_option": true,
          "max_year_delta": "+10",
          "min_year_delta": "0"
        }
      }
    }
  ],
  "fieldsets": [],
  "input_filter": {
    "curtailFrom": {
      "name": "curtailFrom",
      "filters": [
        {
          "name": "DateTimeSelectNullifier"
        }
      ],
      "validators": [
        {
          "name": "\\Common\\Validator\\Date"
        },
        {
          "name": "Date",
          "options": {
            "format": "Y-m-d H:i:s",
            "messages": {
              "dateInvalidDate": "datetime.compare.validation.message.invalid"
            }
          }
        }
      ],
      "required": true
    },
    "curtailTo": {
      "name": "curtailTo",
      "filters": [
        {
          "name": "DateTimeSelectNullifier"
        }
      ],
      "required": false,
      "validators": [
        {
          "name": "ValidateIf",
          "options": {
            "context_field": "curtailTo",
            "context_values": [
              "-- ::00"
            ],
            "context_truth": false,
            "allow_empty": true,
            "validators": [
              {
                "name": "\\Common\\Validator\\Date"
              },
              {
                "name": "Date",
                "options": {
                  "format": "Y-m-d H:i:s",
                  "messages": {
                    "dateInvalidDate": "datetime.compare.validation.message.invalid"
                  }
                },
                "break_chain_on_failure": true
              },
              {
                "name": "DateCompare",
                "options": {
                  "has_time": true,
                  "compare_to": "curtailFrom",
                  "operator": "gt",
                  "compare_to_label": "Curtail from"
                }
              },
              {
                "name": "DateInFuture"
              }
            ]
          }
        }
      ]
    }
  }
}
