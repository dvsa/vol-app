  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true
  },
  "input_filter": {
    "fields": {
      "applicationReceiptDate": {
        "name": "applicationReceiptDate",
        "filters": [
          {
            "name": "DateSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "\\Common\\Validator\\Date"
          },
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d"
            }
          },
          {
            "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture"
          }
        ]
      },
      "vrm": {
        "name": "vrm",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 1,
              "max": 20
            }
          }
        ]
      },
      "hearingDate": {
        "name": "hearingDate",
        "required": false,
        "filters": [
          {
            "name": "Laminas\\Filter\\DateTimeSelect",
            "options": {
              "null_on_empty": true
            }
          }
        ],
        "validators": [
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "impoundingType",
              "context_values": [
                "impt_hearing"
              ],
              "allow_empty": true,
              "validators": [
                {
                  "name": "\\Common\\Validator\\Date"
                },
                {
                  "name": "Date",
                  "options": {
                    "format": "Y-m-d H:i:s"
                  }
                },
                {
                  "name": "DateCompare",
                  "options": {
                    "compare_to": "applicationReceiptDate",
                    "compare_to_label": "Application received",
                    "operator": "gte",
                    "has_time": true
                  }
                }
              ]
            }
          }
        ]
      },
      "venue": {
        "name": "venue",
        "required": false,
        "filters": [
          {
            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "venueOther": {
        "name": "venueOther",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "impoundingType",
              "context_values": [
                "impt_hearing"
              ],
              "validators": [
                {
                  "name": "ValidateIf",
                  "options": {
                    "context_field": "venue",
                    "context_values": [
                      "other"
                    ],
                    "validators": [
                      {
                        "name": "Laminas\\Validator\\StringLength",
                        "options": {
                          "max": 255
                        }
                      },
                      {
                        "name": "Laminas\\Validator\\NotEmpty"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "presidingTc": {
        "name": "presidingTc",
        "required": false,
        "filters": [
          {
            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "outcome": {
        "name": "outcome",
        "required": false,
        "filters": [
          {
            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "outcomeSentDate": {
        "name": "outcomeSentDate",
        "required": false,
        "filters": [
          {
            "name": "DateSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "\\Common\\Validator\\Date"
          },
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d"
            }
          },
          {
            "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture"
          }
        ]
      },
      "notes": {
        "name": "notes",
        "required": false,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 5,
              "max": 4000
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
