{
  "name": "certificate-upload",
  "attributes": {
    "method": "post"
  },
  "elements": [],
  "fieldsets": [
    {
      "flags": [],
      "spec": {
        "name": "file",
        "attributes": {
          "class": "file-uploader"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "fileCount",
              "type": "Hidden"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "file",
              "attributes": {
                "class": "js-visually-hidden"
              },
              "options": {
                "value": "common.file-upload.browse.title",
                "hint": "common.file-upload.browse.hint"
              },
              "type": "\\Common\\Form\\Elements\\Types\\AttachFilesButton"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "__messages__",
              "attributes": [],
              "options": [],
              "type": "Hidden"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "upload",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "inline-upload govuk-button js-upload"
              },
              "options": {
                "label": "Upload"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          }
        ],
        "fieldsets": [
          {
            "flags": [],
            "spec": {
              "name": "list",
              "attributes": {
                "class": "js-upload-list"
              },
              "options": {
                "preview_images": "true"
              },
              "type": "\\Common\\Form\\Elements\\Types\\FileUploadList"
            }
          }
        ],
        "type": "Laminas\\Form\\Fieldset",
        "options": {
          "label": "transport-manager.competences.form.upload.header",
          "hint": "transport-manager.competences.form.upload.text"
        }
      }
    }
  ],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true,
    "action_lcfirst": true
  },
  "input_filter": {
    "file": {
      "fileCount": {
        "name": "fileCount",
        "required": false,
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "Common\\Validator\\FileUploadCountV2",
            "options": {
              "min": 1
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
