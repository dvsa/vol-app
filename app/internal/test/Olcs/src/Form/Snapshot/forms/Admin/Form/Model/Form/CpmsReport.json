{
  "name": "admin-cpms-report",
  "attributes": {
    "method": "post"
  },
  "elements": [],
  "fieldsets": [
    {
      "flags": [],
      "spec": {
        "name": "reportOptions",
        "attributes": [],
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "reportCode",
              "type": "Select",
              "attributes": {
                "id": "reportCode"
              },
              "options": {
                "label": "Report type"
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "startDate",
              "options": {
                "label": "Start date",
                "short-label": "Start date",
                "create_empty_option": true,
                "render_delimiters": false
              },
              "attributes": {
                "required": false
              },
              "type": "DateSelect"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "endDate",
              "options": {
                "label": "End date",
                "short-label": "End date",
                "create_empty_option": true,
                "render_delimiters": false
              },
              "attributes": {
                "required": false
              },
              "type": "DateSelect"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "form-actions",
        "attributes": {
          "class": "govuk-button-group"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "generate",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "govuk-button",
                "id": "submit"
              },
              "options": {
                "label": "Generate"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true,
    "label": "Generate report"
  },
  "input_filter": {
    "reportOptions": {
      "startDate": {
        "name": "startDate",
        "required": true,
        "filters": [
          {
            "name": "DateSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d"
            }
          },
          {
            "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture"
          }
        ]
      },
      "endDate": {
        "name": "endDate",
        "required": true,
        "filters": [
          {
            "name": "DateSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d"
            }
          },
          {
            "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture"
          },
          {
            "name": "DateCompare",
            "options": {
              "has_time": false,
              "compare_to": "startDate",
              "operator": "gte",
              "compare_to_label": "Start date"
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
