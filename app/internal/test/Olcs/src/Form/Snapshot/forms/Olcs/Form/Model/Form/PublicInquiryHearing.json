  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true
  },
  "input_filter": {
    "fields": {
      "venueOther": {
        "name": "venueOther",
        "required": true,
        "validators": [
          {
            "name": "NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "venue",
              "context_values": [
                "other"
              ],
              "allow_empty": false,
              "validators": [
                {
                  "name": "NotEmpty"
                },
                {
                  "name": "Laminas\\Validator\\StringLength",
                  "options": {
                    "max": 255
                  }
                }
              ]
            }
          }
        ]
      },
      "hearingDate": {
        "name": "hearingDate",
        "required": true,
        "filters": [
          {
            "name": "DateTimeSelect",
            "options": {
              "null_on_empty": true
            }
          }
        ],
        "validators": [
          {
            "name": "\\Common\\Validator\\Date"
          },
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d H:i:s"
            }
          }
        ]
      },
      "witnesses": {
        "name": "witnesses",
        "validators": [
          {
            "name": "Digits"
          }
        ]
      },
      "drivers": {
        "name": "drivers",
        "validators": [
          {
            "name": "Digits",
            "options": {
              "messages": {
                "notDigits": "digits.validation.zero-to-ninety-nine",
                "digitsStringEmpty": "digits.validation.zero-to-ninety-nine",
                "digitsInvalid": "digits.validation.zero-to-ninety-nine"
              },
              "break_chain_on_failure": true
            }
          },
          {
            "name": "NotEmpty",
            "options": {
              "messages": {
                "isEmpty": "digits.validation.zero-to-ninety-nine"
              },
              "break_chain_on_failure": true
            }
          },
          {
            "name": "Laminas\\Validator\\Between",
            "options": {
              "min": 0,
              "max": 99,
              "inclusive": true,
              "messages": {
                "notBetween": "digits.validation.zero-to-ninety-nine"
              }
            }
          }
        ]
      },
      "cancelledDate": {
        "name": "cancelledDate",
        "required": true,
        "filters": [
          {
            "name": "DateSelect",
            "options": {
              "null_on_empty": true
            }
          }
        ],
        "validators": [
          {
            "name": "NotEmpty",
            "options": [
              "array"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isCancelled",
              "context_values": [
                "Y"
              ],
              "allow_empty": false,
              "validators": [
                {
                  "name": "NotEmpty"
                },
                {
                  "name": "\\Common\\Validator\\Date"
                },
                {
                  "name": "Date",
                  "options": {
                    "format": "Y-m-d"
                  }
                }
              ]
            }
          }
        ]
      },
      "cancelledReason": {
        "name": "cancelledReason",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isCancelled",
              "context_values": [
                "Y"
              ],
              "allow_empty": false,
              "validators": [
                {
                  "name": "NotEmpty"
                },
                {
                  "name": "Laminas\\Validator\\StringLength",
                  "options": {
                    "max": 1000
                  }
                }
              ]
            }
          }
        ]
      },
      "adjournedDate": {
        "name": "adjournedDate",
        "required": true,
        "filters": [
          {
            "name": "DateTimeSelect",
            "options": {
              "null_on_empty": true
            }
          }
        ],
        "validators": [
          {
            "name": "NotEmpty",
            "options": [
              "array"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isAdjourned",
              "context_values": [
                "Y"
              ],
              "allow_empty": false,
              "validators": [
                {
                  "name": "NotEmpty"
                },
                {
                  "name": "\\Common\\Validator\\Date"
                },
                {
                  "name": "Date",
                  "options": {
                    "format": "Y-m-d H:i:s"
                  }
                }
              ]
            }
          }
        ]
      },
      "adjournedReason": {
        "name": "adjournedReason",
        "required": true,
        "validators": [
          {
            "name": "NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isAdjourned",
              "context_values": [
                "Y"
              ],
              "allow_empty": false,
              "validators": [
                {
                  "name": "NotEmpty"
                },
                {
                  "name": "Laminas\\Validator\\StringLength",
                  "options": {
                    "max": 1000
                  }
                }
              ]
            }
          }
        ]
      },
      "definition": {
        "name": "definition",
        "required": false,
        "filters": [
          {
            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "details": {
        "name": "details",
        "required": false,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 5,
              "max": 4000
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
