        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true
  },
  "input_filter": {
    "fields": {
      "agreedByTcDate": {
        "name": "agreedByTcDate",
        "required": true,
        "filters": [
          {
            "name": "DateSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "\\Common\\Validator\\Date"
          },
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d"
            }
          }
        ]
      },
      "hearingDate": {
        "name": "hearingDate",
        "required": false,
        "filters": [
          {
            "name": "DateTimeSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "\\Common\\Validator\\Date"
          },
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d H:i:s"
            }
          }
        ]
      },
      "venue": {
        "name": "venue",
        "required": false,
        "filters": [
          {
            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "venueOther": {
        "name": "venueOther",
        "required": false,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "venue",
              "context_values": [
                "other"
              ],
              "allow_empty": true,
              "validators": [
                {
                  "name": "Laminas\\Validator\\StringLength",
                  "options": {
                    "max": 255
                  }
                }
              ]
            }
          }
        ]
      },
      "witnessCount": {
        "name": "witnessCount",
        "required": false,
        "filters": [
          {
            "name": "Digits"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\Digits"
          },
          {
            "name": "Laminas\\Validator\\Between",
            "options": {
              "min": 0,
              "max": 99,
              "inclusive": true
            }
          }
        ]
      },
      "presidingStaffName": {
        "name": "presidingStaffName",
        "required": false,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "min": 0,
              "max": 255
            }
          }
        ]
      },
      "outcome": {
        "name": "outcome",
        "required": false,
        "filters": [
          {
            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
