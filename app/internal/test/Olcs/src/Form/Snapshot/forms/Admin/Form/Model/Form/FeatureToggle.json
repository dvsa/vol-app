{
  "name": "FeatureToggle",
  "attributes": {
    "method": "post"
  },
  "elements": [
    {
      "flags": [],
      "spec": {
        "name": "id",
        "attributes": {
          "value": ""
        },
        "type": "Hidden"
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "version",
        "attributes": {
          "value": ""
        },
        "type": "Hidden"
      }
    }
  ],
  "fieldsets": [
    {
      "flags": [],
      "spec": {
        "name": "featureToggleDetails",
        "attributes": [],
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "friendlyName",
              "attributes": {
                "placeholder": "",
                "class": "medium",
                "required": "required"
              },
              "options": {
                "label": "Name of toggle"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "configName",
              "attributes": {
                "placeholder": "",
                "class": "extra-long",
                "required": "required"
              },
              "options": {
                "label": "Config name (usually/ideally the FQDN of a handler)"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "status",
              "options": {
                "label": "Toggle status",
                "category": "feature_toggle_status",
                "label_attributes": {
                  "class": "form-control form-control--radio form-control--inline"
                }
              },
              "type": "DynamicRadio"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "id",
              "attributes": {
                "value": ""
              },
              "type": "Hidden"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "form-actions",
        "attributes": {
          "class": "govuk-button-group"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "submit",
              "attributes": {
                "type": "submit",
                "class": "govuk-button",
                "aria-label": "Save and Continue"
              },
              "options": {
                "label": "Save"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "cancel",
              "attributes": {
                "type": "submit",
                "class": "govuk-button govuk-button--secondary",
                "id": "cancel"
              },
              "options": {
                "label": "Cancel",
                "keepForReadOnly": true
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "addAnother",
              "attributes": {
                "type": "submit",
                "class": "govuk-button govuk-button--secondary"
              },
              "options": {
                "label": "Save and add another"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true
  },
  "input_filter": {
    "featureToggleDetails": {
      "friendlyName": {
        "name": "friendlyName",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "max": 32
            }
          }
        ]
      },
      "configName": {
        "name": "configName",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "max": 255
            }
          }
        ]
      },
      "status": {
        "name": "status",
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty"
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
