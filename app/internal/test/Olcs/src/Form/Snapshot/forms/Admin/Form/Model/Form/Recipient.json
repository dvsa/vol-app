        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true,
    "label": "Recipient"
  },
  "input_filter": {
    "fields": {
      "contactName": {
        "name": "contactName",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "max": 100
            }
          }
        ]
      },
      "emailAddress": {
        "name": "emailAddress",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Dvsa\\Olcs\\Transfer\\Validators\\EmailAddress"
          }
        ]
      },
      "sendAppDecision": {
        "name": "sendAppDecision",
        "validators": [
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "sendNoticesProcs",
              "context_values": [
                "",
                "N"
              ],
              "validators": [
                {
                  "name": "Identical",
                  "options": {
                    "token": "Y",
                    "messages": {
                      "notSame": "Subscription details must be selected"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "trafficAreas": {
        "name": "trafficAreas",
        "required": true
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
