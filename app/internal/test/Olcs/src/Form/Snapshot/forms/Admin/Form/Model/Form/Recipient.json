      }
    },
    {
      "flags": [],
      "spec": {
        "name": "form-actions",
        "attributes": {
          "class": "govuk-button-group"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "submit",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "govuk-button"
              },
              "options": {
                "label": "Save"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "cancel",
              "attributes": {
                "data-module": "govuk-button",
