                "label": "Recipient type",
                "value_options": {
                  "N": "Subscriber",
                  "Y": "Statutory Objector"
                },
                "fieldset-attributes": {
                  "class": "inline"
                }
              },
              "attributes": {
                "id": "isObjector",
                "required": false
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "contactName",
              "attributes": {
                "required": false,
                "id": "contactName",
                "placeholder": "",
                "class": "medium"
              },
              "options": {
                "label": "Contact Name"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "emailAddress",
              "attributes": {
                "required": false,
                "id": "email",
                "placeholder": "",
                "class": "medium"
              },
              "options": {
                "label": "Email"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "sendAppDecision",
              "options": {
                "checked_value": "Y",
