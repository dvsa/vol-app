{
  "name": "Surrender",
  "attributes": [],
  "elements": [],
  "fieldsets": [
    {
      "flags": [],
      "spec": {
        "name": "checks",
        "attributes": {
          "class": "surrenderChecks"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "openCases",
              "type": "Checkbox",
              "attributes": {
                "class": "surrenderChecks__checkbox js-surrender-checks-openCases",
                "disabled": true,
                "checked": true
              },
              "options": {
                "label": "There are no open cases associated with this licence",
                "label_options": {
                  "label_position": "append"
                }
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "busRegistrations",
              "type": "Checkbox",
              "attributes": {
                "class": "surrenderChecks__checkbox js-surrender-checks-busRegistrations",
                "disabled": true,
                "checked": true
              },
              "options": {
                "label": "There are no active bus registrations associated with this licence",
                "label_options": {
                  "label_position": "append"
                }
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "digitalSignature",
              "type": "Checkbox",
              "attributes": {
                "class": "surrenderChecks__checkbox js-surrender-checks-digitalSignature",
                "required": "required"
              },
              "options": {
                "label": "Digital signature has been checked",
                "label_options": {
                  "label_position": "append"
                }
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "ecms",
              "type": "Checkbox",
              "attributes": {
                "class": "surrenderChecks__checkbox js-surrender-checks-ecms",
                "required": "required"
              },
              "options": {
                "label": "ECMS has been checked",
                "label_options": {
                  "label_position": "append"
                }
              }
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "actions",
        "attributes": [],
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "surrender",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "govuk-button govuk-button--disabled js-approve-surrender"
              },
              "options": {
                "label": "Surrender"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "withdraw",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "govuk-button govuk-button--secondary js-modal-ajax"
              },
              "options": {
                "label": "Withdraw",
                "route": "licence/surrender-details/withdraw/GET"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionLink"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "input_filter": {
    "checks": {
      "openCases": {
        "name": "openCases",
        "required": false
      },
      "busRegistrations": {
        "name": "busRegistrations",
        "required": false
      },
      "digitalSignature": {
        "name": "digitalSignature",
        "required": true,
        "validators": [
          {
            "name": "GreaterThan",
            "options": {
              "min": 0,
              "messages": {
                "notGreaterThan": "You must confirm the digital signature has been checked"
              }
            }
          }
        ]
      },
      "ecms": {
        "name": "ecms",
        "required": true,
        "validators": [
          {
            "name": "GreaterThan",
            "options": {
              "min": 0,
              "messages": {
                "notGreaterThan": "You must confirm ECMS has been checked"
              }
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
