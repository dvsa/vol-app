            "name": "Common\\Filter\\NullToArray"
          }
        ]
      },
      "witnesses": {
        "name": "witnesses",
        "validators": [
          {
            "name": "Digits"
          }
        ]
      },
      "decisionDate": {
        "name": "decisionDate",
        "required": false,
        "filters": [
          {
            "name": "DateSelectNullifier"
          }
        ],
        "validators": [
          {
            "name": "\\Common\\Validator\\Date"
          },
          {
            "name": "Date",
            "options": {
              "format": "Y-m-d"
            }
          },
          {
            "name": "\\Common\\Form\\Elements\\Validators\\DateNotInFuture"
          }
        ]
      },
      "notificationDate": {
        "name": "notificationDate",
        "required": false,
        "filters": [
