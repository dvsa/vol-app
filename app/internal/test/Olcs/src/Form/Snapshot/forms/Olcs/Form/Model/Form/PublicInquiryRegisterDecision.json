  "input_filter": {
    "fields": {
      "decisions": {
        "name": "decisions",
        "required": true,
        "validators": [
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "decisionDate",
              "contextValues": [
                null
              ],
              "context_truth": false,
              "validators": [
                {
                  "name": "NotEmpty"
                }
              ]
            }
          }
        ]
      },
      "tmDecisions": {
        "name": "tmDecisions",
        "required": false,
        "allow_empty": true,
        "type": "\\Common\\InputFilter\\ContinueIfEmptyInput",
