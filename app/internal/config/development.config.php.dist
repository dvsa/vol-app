<?php

use Dvsa\Olcs\Utils\Development\DevelopmentConfig;

// What the application does differently in development, such as caching the merged configuration,
// is built in one place so that a change to it reaches this copy too. The settings it reads come
// from the root .env file. See docs/app/local-setup.
//
// The developer toolbar slows every request down, so its modules only load when VOL_DEVTOOLS is on.
return DevelopmentConfig::forApplication(dirname(__DIR__), ['Laminas\DeveloperTools', 'SanSessionToolbar']);
