                                       name="<?= $this->escapeHtmlAttr($groupName) ?>"
                                       id="ctx-choice-<?= $this->escapeHtmlAttr($choice['id']) ?>"
                                       value="<?= $this->escapeHtmlAttr($choice['id']) ?>">
                                <label class="govuk-label govuk-radios__label"
                                       for="ctx-choice-<?= $this->escapeHtmlAttr($choice['id']) ?>">
                                    <?= $this->escapeHtml($choice['label'] ?? $choice['choiceKey'] ?? '') ?>
                                </label>
                            </div>
                            <?php endforeach; ?>
                        </div>
                        <?php else: ?>
                        <div class="govuk-checkboxes govuk-checkboxes--small">
                            <?php foreach ($choices as $choice): ?>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input js-ctx-choice" type="checkbox" name="ctxChoices[]"
