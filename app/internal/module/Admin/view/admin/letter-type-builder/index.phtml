                        <legend class="govuk-label govuk-label--s"><?= $this->escapeHtml($groupLabel) ?></legend>

                        <?php if (($choices[0]['inputType'] ?? 'checkbox') === 'radio'): ?>
                        <div class="govuk-radios govuk-radios--small">
