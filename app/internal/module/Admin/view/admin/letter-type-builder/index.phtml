<?php
/**
 * Letter Type Builder
 *
 * @var int        $letterTypeId
 * @var array|null $letterType
 * @var array      $availableSections
 * @var array      $availableAppendices
 * @var array      $availableChoices
 */

$this->placeholder('pageTitle')->set($letterType['name'] ?? 'Letter Type Builder');

// The composition as saved. The builder hydrates from this so that pressing Save writes back what
// is on screen rather than replacing the stored composition with an empty one.
$savedComposition = ['sections' => [], 'appendices' => []];

foreach ($letterType['letterTypeSections'] ?? [] as $typeSection) {
    $savedComposition['sections'][] = [
        'id' => $typeSection['letterSection']['id'] ?? null,
        'name' => $typeSection['letterSection']['currentVersion']['name']
            ?? $typeSection['letterSection']['sectionKey']
            ?? 'Untitled section',
        'isRequired' => (bool) ($typeSection['isRequired'] ?? false),
        'displayOrder' => (int) ($typeSection['displayOrder'] ?? 0),
    ];
}

// The composition is keyed on the appendix, but only the version carries a name -- letter_appendix
// has no name column of its own.
foreach ($letterType['letterTypeAppendices'] ?? [] as $typeAppendix) {
    $version = $typeAppendix['letterAppendixVersion'] ?? [];

    $savedComposition['appendices'][] = [
        'id' => $version['letterAppendix']['id'] ?? null,
        'name' => $version['name'] ?? 'Untitled appendix',
        'displayOrder' => (int) ($typeAppendix['displayOrder'] ?? 0),
    ];
}

// display_order is the source of truth on the stored side; array position becomes it on save.
foreach (['sections', 'appendices'] as $listKey) {
    usort(
        $savedComposition[$listKey],
        static fn(array $a, array $b): int => $a['displayOrder'] <=> $b['displayOrder']
    );
}
?>

<div id="letter-type-builder"
     data-letter-type-id="<?= $this->escapeHtmlAttr($letterTypeId) ?>"
     data-saved-composition="<?= $this->escapeHtmlAttr(json_encode($savedComposition)) ?>">

    <?php if ($letterTypeId === 0): ?>
