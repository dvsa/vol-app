                    // Choices carry their own input semantics: a radio group is "pick one" --
                    // the create-letter flow enforces exactly that, so a preview context with
                    // both First and Final request describes a letter that can never exist.
                    // Grouped by group_label, mirroring how the caseworker screen presents them.
                    $choiceGroups = [];
                    foreach ($availableChoices as $choice) {
                        $choiceGroups[$choice['groupLabel'] ?? 'Other letter choices'][] = $choice;
                    }
                ?>
                <div class="letter-builder__choices govuk-!-margin-top-2">
                    <?php foreach ($choiceGroups as $groupLabel => $choices): ?>
                    <?php $groupName = 'ctxChoiceGroup-' . md5((string) $groupLabel); ?>
