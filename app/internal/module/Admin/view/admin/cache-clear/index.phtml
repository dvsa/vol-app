<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Clear cache</h1>

        <p class="govuk-body">
            Clear cached translations, feature toggles and system parameters.
            Changes should become visible after the cache has been cleared.
        </p>

        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Clearing the cache may temporarily affect application performance while the cache is rebuilt.
            </strong>
        </div>

        <form method="post">
            <button
                type="submit"
                class="govuk-button"
                data-module="govuk-button"
            >
                Clear cache
            </button>
        </form>
    </div>
</div>