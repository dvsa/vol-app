                data-issue-ids="<?= $this->escapeHtmlAttr(implode(',', $previousLetter['issueIds'])) ?>">
            <?= $this->escapeHtml($previousLetter['label']) ?>
        </option>
        <?php endforeach; ?>
    </select>
    <p class="govuk-body-s" id="previous-letter-note" role="status" style="display: none; margin: 10px 0 0;"></p>
