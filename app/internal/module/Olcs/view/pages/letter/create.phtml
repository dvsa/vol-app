<?= $this->partial('pages/letter/partials/issue-accordion', ['accordionData' => $accordionData, 'selectedIssueIds' => []]) ?>

<?php if (!empty($appendicesData)): ?>
<div class="letter-appendices letter-group">
    <div class="letter-group__header">
        <h3 class="letter-group__title govuk-heading-s">Appendices</h3>
