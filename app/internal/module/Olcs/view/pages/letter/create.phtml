<?php if (!empty($letterChoicesData)): ?>
<div class="letter-choices">
    <?php
    // Group choices by groupLabel
    $groupedChoices = [];
    foreach ($letterChoicesData as $choice) {
        $group = $choice['groupLabel'] ?? 'Other letter choices';
        $groupedChoices[$group][] = $choice;
    }
    ?>
    <?php $groupIndex = 0; ?>
    <?php foreach ($groupedChoices as $groupLabel => $choices): ?>
        <?php $isRadioGroup = (($choices[0]['inputType'] ?? 'checkbox') === 'radio'); ?>
        <?php if ($isRadioGroup): ?>
            <?php // Radio "pick one" group: shared name, no default selected, must pick exactly one. ?>
            <div class="govuk-form-group letter-group" data-required-radio-group>
                <div class="letter-group__header">
                    <h3 class="letter-group__title govuk-heading-s"><?= $this->escapeHtml($groupLabel) ?></h3>
                </div>
                <div class="letter-group__content">
                <p class="govuk-hint govuk-!-margin-bottom-1">Select one</p>
                <p class="govuk-error-message letter-choice-group-error" style="display: none;">
                    <span class="govuk-visually-hidden">Error:</span> Select <?= $this->escapeHtml($groupLabel) ?>
                </p>
                <div class="govuk-radios govuk-radios--small">
                    <?php foreach ($choices as $choice): ?>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" name="letterChoiceGroup[<?= $groupIndex ?>]"
                                   type="radio"
                                   value="<?= $choice['id'] ?>"
                                   id="letter-choice-<?= $choice['id'] ?>">
                            <label class="govuk-label govuk-radios__label" for="letter-choice-<?= $choice['id'] ?>">
                                <?= $this->escapeHtml($choice['label']) ?>
                            </label>
                        </div>
                    <?php endforeach; ?>
                </div>
                </div>
            </div>
        <?php else: ?>
            <div class="letter-group">
                <div class="letter-group__header">
                    <h3 class="letter-group__title govuk-heading-s"><?= $this->escapeHtml($groupLabel) ?></h3>
                </div>
                <div class="letter-group__content">
                    <div class="govuk-checkboxes govuk-checkboxes--small">
                        <?php foreach ($choices as $choice): ?>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" name="letterChoices[]"
                                       type="checkbox"
                                       value="<?= $choice['id'] ?>"
                                       id="letter-choice-<?= $choice['id'] ?>">
                                <label class="govuk-label govuk-checkboxes__label" for="letter-choice-<?= $choice['id'] ?>">
                                    <?= $this->escapeHtml($choice['label']) ?>
                                </label>
                            </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            </div>
        <?php endif; ?>
        <?php $groupIndex++; ?>
    <?php endforeach; ?>
</div>
<?php endif; ?>

