                       <?= $appendix['isMandatory'] ? 'checked disabled' : '' ?>>
                <label class="govuk-label govuk-checkboxes__label" for="letter-appendix-<?= $appendix['id'] ?>">
                    <?= $this->escapeHtml($appendix['name']) ?>
