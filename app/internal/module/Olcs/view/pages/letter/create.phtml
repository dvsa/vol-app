                </label>
                <?php if ($appendix['isMandatory']): ?>
                    <input type="hidden" name="letterAppendices[]" value="<?= $appendix['id'] ?>">
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
    </div>
</div>
