<?php
/**
 * Letter Preview Sidebar
 *
 * Left sidebar for the letter preview page: a tick box for each thing that can be edited, in
 * the order the edit page shows them, and the action buttons
 *
 * @var array $letterInstance Letter instance data
 * @var array $layout Letter order: [['section' => ...] | ['issues' => true], ...]
 * @var array $groupedIssues Issues grouped by type, each with the to-dos listed under it
 * @var array $unplacedTodos To-dos with none of their issues on the letter
 * @var array $appendicesList Editable appendices
 */

// a sent letter can't be changed (VOL-7735), so it has nothing to pick for editing
$open = !empty($letterInstance['isOpenForChanges']);
?>

<?php if (!$open): ?>
<div class="small-module">
    <p class="small-module__details">
        <?= empty($letterInstance['isSent'])
            ? 'This letter can no longer be changed.'
            : 'This letter has been sent, so it can no longer be changed.' ?>
    </p>
</div>
<?php else: ?>
<?php
$hasSections = array_filter($layout, static fn (array $block): bool => isset($block['section'])) !== [];
$hasIssues = array_filter($groupedIssues, static fn (array $group): bool => !empty($group['issues'])) !== [];
$hasEditable = $hasSections || $hasIssues || !empty($unplacedTodos);
?>
<?php if ($hasEditable || !empty($appendicesList)): ?>
<p class="govuk-body govuk-!-margin-bottom-2">
    <?php // Ticks every section below in one go (VOL-7736); letter-preview.js flips the label. ?>
    <button type="button" id="select-all-sections" class="govuk-link"
            style="background: none; border: 0; padding: 0; cursor: pointer; font: inherit;">Select all</button>
</p>
<?php endif; ?>

<div class="small-module">
    <h4 class="title">Edit sections:</h4>
    <?php if ($hasEditable): ?>
    <?php // Same order as the edit page: sections where they sit in the letter, each issue
          // followed by its own to-dos, then any to-dos left over. ?>
    <div class="govuk-checkboxes govuk-checkboxes--small small-module__details">
        <?php foreach ($layout as $block): ?>
            <?php if (isset($block['section'])): ?>
                <?= $this->partial('pages/letter/partials/sidebar-checkbox', [
                    'field' => 'letterSections', 'idPrefix' => 'letter-section', 'item' => $block['section'],
                ]) ?>
            <?php else: ?>
                <?php foreach ($groupedIssues as $group): ?>
                    <?php foreach ($group['issues'] as $issue): ?>
                        <?= $this->partial('pages/letter/partials/sidebar-checkbox', [
                            'field' => 'sections', 'idPrefix' => 'section', 'item' => $issue,
                        ]) ?>
                        <?php foreach ($issue['todos'] ?? [] as $todo): ?>
                            <?= $this->partial('pages/letter/partials/sidebar-checkbox', [
                                'field' => 'todos', 'idPrefix' => 'todo', 'item' => $todo, 'underIssue' => true,
                            ]) ?>
                        <?php endforeach; ?>
                    <?php endforeach; ?>
                <?php endforeach; ?>
                <?php foreach ($unplacedTodos as $todo): ?>
                    <?= $this->partial('pages/letter/partials/sidebar-checkbox', [
                        'field' => 'todos', 'idPrefix' => 'todo', 'item' => $todo,
                    ]) ?>
                <?php endforeach; ?>
            <?php endif; ?>
        <?php endforeach; ?>
    </div>
    <?php else: ?>
    <p class="small-module__details">No sections selected</p>
    <?php endif; ?>
</div>

<?php if (!empty($appendicesList)): ?>
<div class="small-module">
    <h4 class="title">Editable Appendices:</h4>
    <div class="govuk-checkboxes govuk-checkboxes--small small-module__details">
        <?php foreach ($appendicesList as $appendix): ?>
            <?= $this->partial('pages/letter/partials/sidebar-checkbox', [
                'field' => 'appendices', 'idPrefix' => 'appendix', 'item' => $appendix,
            ]) ?>
        <?php endforeach; ?>
    </div>
</div>
<?php endif; ?>
<?php endif; ?>

<div class="small-module">
    <h4 class="title">Actions</h4>
    <p class="small-module__details">
        <?php if ($open): ?>
        <button
            type="button"
            id="change-issues-btn"
            class="govuk-button govuk-button--secondary"
            data-letter-instance-id="<?= $this->escapeHtmlAttr($letterInstance['id'] ?? '') ?>"
            data-from="preview"
            style="margin-bottom: 10px; width: 100%;"
        >
            Change issues
        </button>
        <button
            type="button"
            id="continue-to-editor"
            class="govuk-button govuk-button--secondary"
            data-letter-instance-id="<?= $this->escapeHtmlAttr($letterInstance['id'] ?? '') ?>"
            disabled
            style="margin-bottom: 10px; width: 100%;"
        >
            Continue to editor
        </button>
        <?php endif; ?>
        <button
            type="button"
            id="save-letter-exit"
            class="govuk-button"
            data-letter-instance-id="<?= $this->escapeHtmlAttr($letterInstance['id'] ?? '') ?>"
            style="width: 100%;"
        >
            Save letter and exit
        </button>
    </p>
</div>
