<?php
/**
 * One to-do editor on the letter edit page.
 *
 * @var array $todo id, name, content, version, requiringIssueCount, isCustom
 * @var string|null $headingTag h3 by default; h5 when nested under an issue
 */
$headingTag = in_array($headingTag ?? 'h3', ['h3', 'h4', 'h5'], true) ? ($headingTag ?? 'h3') : 'h3';
?>
<div class="govuk-form-group todo-editor-group"
     data-todo-id="<?= $this->escapeHtmlAttr($todo['id']) ?>"
     data-version="<?= $this->escapeHtmlAttr($todo['version']) ?>">
    <<?= $headingTag ?> class="govuk-heading-s"><?= $this->escapeHtml($todo['name']) ?></<?= $headingTag ?>>

    <?php // A to-do is deduplicated, so one shared by several issues appears once in the letter
          // (see LetterInstance::getPlacementIssue). Say so, or an edit here looks narrower than it is. ?>
    <?php if (($todo['requiringIssueCount'] ?? 1) > 1): ?>
        <p class="govuk-inset-text govuk-!-margin-top-0">
            This to-do is required by <?= $this->escapeHtml($todo['requiringIssueCount']) ?>
            issues in this letter. Editing it here changes it once, wherever it appears.
        </p>
    <?php endif; ?>

    <div class="editorjs-container" data-element-name="todo_<?= $this->escapeHtmlAttr($todo['id']) ?>">
        <div id="editor-todo-<?= $this->escapeHtmlAttr($todo['id']) ?>" class="editorjs-editor"></div>
        <input type="hidden"
               name="todo_<?= $this->escapeHtmlAttr($todo['id']) ?>"
               value="<?= $this->escapeHtmlAttr($todo['content']) ?>">
    </div>

    <div style="margin-top: 10px;">
        <button type="button"
                class="govuk-button save-todo-btn"
                data-todo-id="<?= $this->escapeHtmlAttr($todo['id']) ?>"
                data-version="<?= $this->escapeHtmlAttr($todo['version']) ?>">
            Save changes
        </button>
        <?php if (!empty($todo['isCustom'])): ?>
            <?php // written by the caseworker on this letter, so they can remove it (VOL-7735) ?>
            <button type="button"
                    class="govuk-button govuk-button--warning delete-custom-todo-btn"
                    data-todo-id="<?= $this->escapeHtmlAttr($todo['id']) ?>"
                    style="margin-left: 10px;">
                Delete to-do
            </button>
        <?php endif; ?>
        <span class="save-indicator govuk-tag govuk-tag--green" style="display: none; margin-left: 10px;">
            Saved
        </span>
    </div>
</div>

<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
