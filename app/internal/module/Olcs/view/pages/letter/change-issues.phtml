<?php
/**
 * Change the issues on a letter that has already been generated (VOL-7734). Loaded into a modal
 * from the preview and edit pages; driven by assets/js/inline/forms/letter-change-issues.js.
 *
 * @var int $letterInstanceId
 * @var string $from 'preview' or 'edit', where to go back to after saving
 * @var bool $locked the letter can no longer be changed
 * @var bool $hasAppendices whether every issue may be unticked
 * @var array $accordionData
 * @var array $selectedIssueIds
 * @var string $csrfToken posted back as "security", see Common\Module::validateCsrfToken
 */
?>
<?php if ($locked): ?>
    <p class="govuk-body">This letter can no longer be changed.</p>
    <button type="button" class="govuk-button govuk-button--secondary js-change-issues-close">Close</button>
<?php else: ?>
<form id="change-issues-form"
      data-letter-instance-id="<?= $this->escapeHtmlAttr($letterInstanceId) ?>"
      data-from="<?= $this->escapeHtmlAttr($from) ?>"
      data-has-appendices="<?= $hasAppendices ? '1' : '0' ?>">
    <input type="hidden" name="security" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">

    <div id="change-issues-error" class="govuk-error-summary" role="alert" tabindex="-1" style="display: none;">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <p class="govuk-body" id="change-issues-error-message"></p>
        </div>
    </div>

    <div id="change-issues-select">
        <p class="govuk-body">Tick the issues this letter should cover. Edits you have made to issues you keep are not changed.</p>

        <?= $this->partial('pages/letter/partials/issue-accordion', [
            'accordionData' => $accordionData,
            'selectedIssueIds' => $selectedIssueIds,
        ]) ?>

        <div class="govuk-button-group">
            <button type="button" id="change-issues-save" class="govuk-button">Save issues</button>
            <button type="button" class="govuk-button govuk-button--secondary js-change-issues-close">Cancel</button>
        </div>
    </div>

    <div id="change-issues-confirm" style="display: none;">
        <h2 class="govuk-heading-m">These edits will be lost</h2>
        <p class="govuk-body">You have edited the following, and they will be removed from the letter:</p>
        <ul class="govuk-list govuk-list--bullet" id="change-issues-confirm-list"></ul>
        <div class="govuk-button-group">
            <button type="button" id="change-issues-confirm-continue" class="govuk-button govuk-button--warning">Remove them</button>
            <button type="button" id="change-issues-confirm-cancel" class="govuk-button govuk-button--secondary">Go back</button>
        </div>
    </div>
</form>
<?php endif; ?>
