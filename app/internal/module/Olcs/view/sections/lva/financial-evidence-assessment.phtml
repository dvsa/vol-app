<?php
/**
 * Financial evidence assessment: one tab per successful document analysis.
 *
 * Each tab's content comes ready to display from Olcs\Data\Mapper\FinancialEvidenceAssessmentTab.
 * Remarks and values are model-generated text, so everything that came from the API is escaped here.
 */
$warningText = $hasDocuments
  ? $this->translate('lva-financial-evidence-assessment-statement-warning')
  : $this->translate('lva-financial-evidence-assessment-no-statements-warning');
?>
<div class="govuk-warning-text">
  <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
  <strong class="govuk-warning-text__text">
    <span class="govuk-visually-hidden"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-warning-label')); ?></span>
    <?php echo $warningText; ?>
  </strong>
</div>

<div class="govuk-tabs" data-module="govuk-tabs">
  <ul class="govuk-tabs__list">
    <?php
    // govuk-frontend switches tabs in the browser by moving the --selected class, so every header
    // renders both its selected and unselected state; the internal theme's
    // views/internal/financial-evidence-assessment styles show the right one.
    ?>
    <?php // Tab labels and statuses are translation keys (a tab labelled by its date translates to itself). ?>
    <?php foreach ($tabs as $index => $tab) : ?>
      <?php
      $itemClasses = 'govuk-tabs__list-item fea-tab';
      $itemClasses .= $index === 0 ? ' govuk-tabs__list-item--selected' : '';
      $itemClasses .= $tab['unselectedLabel'] !== null ? ' fea-tab--has-unselected-label' : '';
      ?>
      <li class="<?php echo $this->escapeHtmlAttr($itemClasses); ?>">
        <a class="govuk-tabs__tab" href="#<?php echo $this->escapeHtmlAttr($tab['id']); ?>">
          <span class="fea-tab__label"><?php echo $this->escapeHtml($this->translate($tab['label'])); ?></span>
          <?php if ($tab['unselectedLabel'] !== null) : ?>
            <span class="fea-tab__label--unselected"><?php echo $this->escapeHtml($this->translate($tab['unselectedLabel'])); ?></span>
          <?php endif; ?>
          <?php // Hidden on the selected tab: its panel already shows the status next to the filename. ?>
          <strong class="govuk-tag govuk-!-margin-left-2 fea-tab__status <?php echo $this->escapeHtmlAttr($tab['statusTag']); ?>">
            <?php echo $this->escapeHtml($this->translate($tab['status'])); ?>
          </strong>
        </a>
      </li>
    <?php endforeach; ?>
  </ul>

  <?php foreach ($tabs as $index => $tab) : ?>
    <div class="govuk-tabs__panel<?php echo $index === 0 ? '' : ' govuk-tabs__panel--hidden'; ?>"
         id="<?php echo $this->escapeHtmlAttr($tab['id']); ?>">
      <h2 class="govuk-heading-m"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-heading')); ?></h2>

      <?php if ($tab['document'] !== null) : ?>
        <p class="govuk-body">
          <strong><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-filename')); ?></strong>
          <a class="govuk-link" href="<?php echo $this->url('getfile', ['identifier' => $tab['document']['id']]); ?>">
            <?php echo $this->escapeHtml($tab['document']['name'] ?? $this->translate('lva-financial-evidence-assessment-document-fallback-name')); ?>
          </a>
          <strong class="govuk-tag govuk-!-margin-left-4 <?php echo $this->escapeHtmlAttr($tab['statusTag']); ?>">
            <?php echo $this->escapeHtml($this->translate($tab['status'])); ?>
          </strong>
        </p>
      <?php endif; ?>

      <?php if (!$tab['hasAssessment']) : ?>
        <p class="govuk-body">
          <?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-no-assessment')); ?>
        </p>
      <?php else : ?>
        <table class="govuk-table">
          <caption class="govuk-table__caption govuk-visually-hidden"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-table-caption')); ?></caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header govuk-!-width-one-half"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-column-information')); ?></th>
              <th scope="col" class="govuk-table__header"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-column-flag')); ?></th>
              <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-column-remark')); ?></span></th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
          <?php foreach ($tab['rows'] as $row) : ?>
            <?php
            // Set when a caseworker has answered this check: changed it (either way) or left a
            // note on it. A change has an original flag different from the flag the row has now.
            $override = $row['override'] ?? null;
            $changed = $override !== null && $override['originalFlag'] !== $row['flag'];
            ?>
            <tr class="govuk-table__row">
              <th scope="row" class="govuk-table__header">
                <?php echo $this->escapeHtml($this->translate($row['label'])); ?><?php if ($row['value'] !== null) : ?>:
                  <span class="govuk-!-font-weight-regular"><?php echo $this->escapeHtml($row['value']); ?></span>
                <?php endif; ?>
              </th>
              <td class="govuk-table__cell">
                <?php // The analyser's flag, greyed out when a caseworker changed it (the new flag is with their comment). ?>
                <?php echo $this->partial('partials/financial-evidence/flag', [
                  'original' => $changed ? $override['originalFlag'] : null,
                  'current' => $row['flag'],
                  'currentTag' => $row['flagTag'],
                ]); ?>
              </td>
              <td class="govuk-table__cell">
                <?php
                // This column shows one thing, as the design draws it: the caseworker's comment once
                // they have answered the check (a change, or a note that keeps the flag), and
                // otherwise the analyser's remark. The remark is still shown for every check on
                // the change document review pages.
                ?>
                <?php if ($override !== null) : ?>
                  <?php echo $this->partial('partials/financial-evidence/comment', [
                    'tag' => $changed ? $row['flag'] : null,
                    'tagClass' => $changed ? $row['flagTag'] : null,
                    'comment' => $override['comment'],
                    'author' => $override['changedBy'],
                    'date' => $override['changedOn'],
                    'answered' => true,
                  ]); ?>
                <?php elseif ($row['remark'] !== null) : ?>
                  <?php echo $this->escapeHtml($row['remark']); ?>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
          </tbody>
        </table>

        <h3 class="govuk-heading-s"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-summary-heading')); ?></h3>
        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-summary-issues')); ?></dt>
            <dd class="govuk-summary-list__value">
              <?php
              $issueCount = $tab['issueCount'];
              // One translation key per case: no issues, one, or several (the count goes into
              // the text with sprintf, so each language can place it where it belongs).
              echo $this->escapeHtml(match (true) {
                  $issueCount === 0 => $this->translate('lva-financial-evidence-assessment-issues-found-none'),
                  $issueCount === 1 => sprintf($this->translate('lva-financial-evidence-assessment-issues-found-one'), $issueCount),
                  default => sprintf($this->translate('lva-financial-evidence-assessment-issues-found-many'), $issueCount),
              });
              ?>
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key"><?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-summary-status')); ?></dt>
            <dd class="govuk-summary-list__value"><?php echo $this->escapeHtml($this->translate($tab['status'])); ?></dd>
          </div>
        </dl>
      <?php endif; ?>

      <?php
      // One review form serves every tab; only the analysis differs. The application or licence
      // comes from the route, not the form.
      $reviewForm->get('analysisId')->setValue((string)$tab['analysisId']);
      ?>
      <form method="post" novalidate>
        <?php echo $this->formElement($reviewForm->get('security')); ?>
        <?php echo $this->formElement($reviewForm->get('analysisId')); ?>
        <div class="govuk-button-group">
          <?php // Only offered until a review is recorded, and only when there is an assessment to decide on. ?>
          <?php if ($tab['canReview']) : ?>
            <?php echo $this->formElement($reviewForm->get('review')); ?>
          <?php endif; ?>
          <?php // Opens the change document review page; offered for any analysis with an assessment, decided or not. ?>
          <?php if ($tab['changeReviewUrl'] !== null) : ?>
            <a href="<?php echo $this->escapeHtmlAttr($tab['changeReviewUrl']); ?>"
               role="button" draggable="false"
               class="govuk-button govuk-button--secondary" data-module="govuk-button">
              <?php echo $this->escapeHtml($this->translate('lva-financial-evidence-assessment-change-document-review')); ?>
            </a>
          <?php endif; ?>
        </div>
      </form>
    </div>
  <?php endforeach; ?>
</div>
