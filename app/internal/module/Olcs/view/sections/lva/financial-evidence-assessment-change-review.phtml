<?php
/**
 * Change document review: the issues the automated analyser raised on one document, each with
 * a form to change it to a pass, the checks that passed, and the caseworker's decision on the
 * evidence. Layout follows the ticket design: issues, then passes, then the decision.
 *
 * Issues come from Olcs\Data\Mapper\FinancialEvidenceAssessmentReview as plain text and are
 * escaped here (remarks are model-generated, comments are free text). The passes table is built
 * by the table helper, whose formatters escape it. Both forms post back to this page, which
 * redirects after handling them.
 */
?>
<a class="govuk-back-link" href="<?php echo $this->escapeHtmlAttr($backUrl); ?>">Back</a>

<h2 class="govuk-heading-s govuk-!-margin-bottom-2">Finance evidence document overview</h2>
<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

<h3 class="govuk-heading-m">Bank Statements</h3>

<?php if ($document !== null) : ?>
  <dl class="govuk-summary-list govuk-!-margin-bottom-8">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Finance Evidence</dt>
      <dd class="govuk-summary-list__value">
        <a class="govuk-link" href="<?php echo $this->escapeHtmlAttr($this->url('getfile', ['identifier' => $document['id']])); ?>">
          <?php echo $this->escapeHtml($document['name'] ?? 'Document'); ?>
        </a>
      </dd>
    </div>
  </dl>
<?php endif; ?>

<?php foreach ($issues as $issue) : ?>
  <?php $key = $this->escapeHtmlAttr($issue['key']); ?>
  <h3 class="govuk-heading-m">Issue</h3>
  <dl class="govuk-summary-list">
    <?php // Only when the value names what failed; the mapper leaves it null otherwise. ?>
    <?php if ($issue['value'] !== null) : ?>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key"><?php echo $this->escapeHtml($issue['label']); ?></dt>
        <dd class="govuk-summary-list__value"><?php echo $this->escapeHtml($issue['value']); ?></dd>
      </div>
    <?php endif; ?>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Flag</dt>
      <dd class="govuk-summary-list__value">
        <strong class="govuk-tag <?php echo $this->escapeHtmlAttr($issue['flagTag']); ?>">
          <?php echo $this->escapeHtml($issue['flag']); ?>
        </strong>
        <?php echo $this->escapeHtml((string)($issue['remark'] ?? '')); ?>
        <?php // A changed issue keeps the analyser's flag (greyed out) and shows what replaced it. ?>
        <?php if ($issue['changed']) : ?>
          <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-0">
            Changed to
            <strong class="govuk-tag <?php echo $this->escapeHtmlAttr((string)$issue['changedToTag']); ?>">
              <?php echo $this->escapeHtml((string)$issue['changedTo']); ?>
            </strong>
            by <strong><?php echo $this->escapeHtml($issue['changedBy'] ?? 'Unknown user'); ?></strong>
          </p>
        <?php endif; ?>
      </dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Comment</dt>
      <dd class="govuk-summary-list__value"><?php echo $this->escapeHtml($issue['comment'] ?? '-'); ?></dd>
    </div>
  </dl>

  <?php if (!$issue['changed']) : ?>
    <?php
    // One override form serves every issue; only the row differs. Values are reset so one
    // issue's input never shows against another, and ids are made unique per issue.
    $overrideForm->get('analysisId')->setValue((string)$analysisId);
    $overrideForm->get('row')->setValue($issue['key']);
    $overrideForm->get('changeRecommendation')->setValue('N')->setAttribute('id', 'changeRecommendation-' . $issue['key']);
    $overrideForm->get('comment')->setValue('')->setAttribute('id', 'comment-' . $issue['key']);
    ?>
    <?php // A native disclosure, as in the design; it works without JavaScript, unlike an accordion. ?>
    <details class="govuk-details" id="change-<?php echo $key; ?>">
      <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">Do you want to change the recommendation above?</span>
      </summary>
      <div class="govuk-details__text">
        <form method="post" novalidate>
          <?php echo $this->formElement($overrideForm->get('security')); ?>
          <?php echo $this->formElement($overrideForm->get('analysisId')); ?>
          <?php echo $this->formElement($overrideForm->get('row')); ?>
          <?php echo $this->formRow($overrideForm->get('changeRecommendation')); ?>
          <?php echo $this->formRow($overrideForm->get('comment')); ?>
          <div class="govuk-button-group">
            <?php echo $this->formElement($overrideForm->get('saveOverride')); ?>
          </div>
        </form>
      </div>
    </details>
  <?php endif; ?>

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
<?php endforeach; ?>

<?php if ($issues === []) : ?>
  <p class="govuk-body">No issues were found.</p>
  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
<?php endif; ?>

<h3 class="govuk-heading-m">Pass Issues</h3>
<p class="govuk-body">
  There <?php echo $passCount === 1 ? 'is' : 'are'; ?>
  <?php echo (int)$passCount; ?> <?php echo $passCount === 1 ? 'issue' : 'issues'; ?> shown as
  <strong class="govuk-tag govuk-tag--green">PASS</strong>
</p>
<?php echo $passesTable->render(); ?>

<h3 class="govuk-heading-s">Do you want to change any of the recommendations above?</h3>
<?php // Placeholder from the design: not wired to any command yet. ?>
<button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button">
  Change and Review
</button>

<form method="post" novalidate class="govuk-!-margin-top-6">
  <?php echo $this->formElement($decisionForm->get('security')); ?>
  <?php echo $this->formElement($decisionForm->get('analysisId')); ?>
  <div class="govuk-form-group">
    <?php echo $this->formRow($decisionForm->get('decision')); ?>
  </div>  <div class="govuk-button-group">
    <?php echo $this->formElement($decisionForm->get('saveDecision')); ?>
  </div>
</form>
