    "@editorjs/paragraph": "^2.10.0",
    "@editorjs/underline": "^1.2.1",
    "autoprefixer": "^10.4.20",
    "chosen-npm": "^1.4.2",
    "govuk-frontend": "^6.4.0",
    "jquery": "^3.7.1",
    "pace-progress": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@lodder/grunt-postcss": "^3.1.1",
    "@playwright/test": "^1.49.0",
    "cssnano": "^7.0.4",
    "grunt": "^1.0.3",
