{
  "name": "olcs-static",
  "version": "0.29.0",
  "scripts": {
    "build:container": "./node_modules/grunt-cli/bin/grunt build:container",
    "build:grunt:production": "./node_modules/grunt-cli/bin/grunt --no-color build:production",
    "build:grunt:staging": "./node_modules/grunt-cli/bin/grunt --no-color build:staging",
    "build:production": "npm run build:grunt:production",
    "build:staging": "npm run build:grunt:staging",
    "start": "./node_modules/grunt-cli/bin/grunt serve",
