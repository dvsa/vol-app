<div id="main">
    <?php
    $formErrors = $this->formErrors($form);

    if (isset($failed) && $failed) {
        $formErrors .= sprintf(
            '<div class="validation-summary"><h2>%s</h2><p>%s</p></div>',
            $this->escapeHtml($this->translate('auth.forgot-password.failed.title')),
            $this->escapeHtml($this->translate($failureReason))
        );
    }

    if ($formErrors !== '') {
        $formErrors = '<div class="row"><div class="two-thirds">'
            . $formErrors . '</div></div>';
    }

    echo $this->partial(
        'partials/page-header-simple',
        [
            'pageTitle' => $this->translate('auth.forgot-password.title'),
            'formErrors' => $formErrors,
            'backUrl' => [
                'url' => $this->url('auth/login/GET'),
            ],
        ]
    );
    ?>

    <div class="row">
        <div class="two-thirds">
            <?php
            echo $this->flashMessengerAll();
            $username = $form->get('username');
            $username->setAttribute('class', $username->getAttribute('class') . ' long');

            echo $this->form()->openTag($form); ?>
                <fieldset>
                    <?php echo $this->formRow($form->get('username')); ?>
                    <div class="govuk-button-group">
                        <?php echo $this->formElement($form->get('submit')); ?>
                        <?php echo $this->formElement($form->get('cancel')); ?>
                    </div>
                    <div class="govuk-button-group">
                        <a class="govuk-link" href="<?php echo $this->url('user-forgot-username'); ?>">
                            <?php echo $this->escapeHtml($this->translate('auth.forgot-username.label')); ?>
                        </a>
                    </div>
                </fieldset>
            <?php echo $this->formElement($form->get('security')); ?>
            <?php echo $this->form()->closeTag(); ?>
        </div>
    </div>
</div>
