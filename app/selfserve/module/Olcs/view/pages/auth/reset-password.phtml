<div id="main">
    <?php
    $formErrors = $this->formErrors($form);
    if (isset($failed) && $failed) {
        $formErrors .= sprintf(
            '<div class="validation-summary"><h2>%s</h2><p>%s</p></div>',
            $this->escapeHtml($this->translate('auth.reset-password.failed.title')),
            $this->escapeHtml($this->translate($failureReason))
        );
    }

    if ($formErrors !== '') {
        $formErrors = '<div class="row"><div class="two-thirds">' . $formErrors . '</div></div>';
    }

    echo $this->partial(
        'partials/page-header-simple',
        [
            'pageTitle' => $this->translate('auth.reset-password.title'),
            'formErrors' => $formErrors,
        ]
    );
    ?>

    <div class="row">
        <div class="two-thirds">
            <?php
            echo $this->flashMessengerAll();
            $newPassword = $form->get('newPassword');
            $newPassword->setAttribute('class', $newPassword->getAttribute('class') . ' long');

            $confirmPassword = $form->get('confirmPassword');
            $confirmPassword->setAttribute('class', $confirmPassword->getAttribute('class') . ' long');

            echo $this->form()->openTag($form); ?>
                <fieldset>
                    <?php echo $this->formRow($form->get('newPassword')); ?>
                    <?php echo $this->formRow($form->get('confirmPassword')); ?>
                    <div class="govuk-button-group">
                        <?php echo $this->formElement($form->get('submit')); ?>
                    </div>
                </fieldset>
            <?php echo $this->formElement($form->get('security')); ?>
            <?php echo $this->form()->closeTag(); ?>
        </div><!-- .two-thirds -->
    </div>
</div>
