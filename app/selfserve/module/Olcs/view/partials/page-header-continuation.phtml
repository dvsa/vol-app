<div class="page-header">

    <?php echo $this->flashMessengerAll(); ?>

    <?php
    if ($this->backUrl === true) {
        echo $this->linkBack();
    } elseif (is_array($this->backUrl) && count($this->backUrl) > 0) {
        echo $this->linkBack($this->backUrl);
    }
    ?>

    <div class="page-header__wrapper">
        <?php if (isset($this->stepHeader)) : ?>
            <p class="page-header__subtitle h3"><?php echo $this->stepHeader; ?></p>
        <?php endif; ?>
        <h1 class="js-title no-margin">
            <?php echo $this->escapeHtml($this->pageTitle); ?>
        </h1>
        <?php if ($this->pageSubTitle !== '') : ?>
            <p class="page-header__subtitle h3">
                <?php echo $this->escapeHtml($this->pageSubTitle); ?>
            </p>
        <?php endif; ?>
    </div>
</div><!-- page-header-->
