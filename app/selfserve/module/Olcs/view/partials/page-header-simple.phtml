<div class="page-header">

    <?php echo $this->flashMessengerAll(); ?>

    <?php
    $backLink = '';
    if ($this->backUrl === true) {
        $backLink = $this->linkBack();
    } elseif (is_array($this->backUrl) && count($this->backUrl) > 0) {
        $backLink = $this->linkBack($this->backUrl);
    }
    echo $backLink;
    ?>

    <?php if (!empty($this->formErrors)): ?>
        <?php if ($backLink === ''): ?>
            <div class="govuk-!-margin-top-4">
        <?php endif; ?>
        <?php if (!empty($this->formErrorsWidth)): ?>
            <div class="row">
                <div class="<?php echo $this->escapeHtmlAttr($this->formErrorsWidth); ?> lva-details">
                    <?php echo $this->formErrors; ?>
                </div>
            </div>
        <?php else: ?>
            <?php echo $this->formErrors; ?>
        <?php endif; ?>
        <?php if ($backLink === ''): ?>
            </div>
        <?php endif; ?>
    <?php endif; ?>

    <div class="page-header__wrapper">
        <?php if (!empty($this->pageSubTitle)) : ?>
            <span class="page-header__subtitle page-header__h3"><?php
                echo (
                    $this->pageSubTitleEscape === false
                    ? $this->pageSubTitle
                    : $this->escapeHtml($this->pageSubTitle)
                )
            ?></span>
        <?php endif; ?>

        <h1 class="js-title"><?php
            echo (
                $this->pageTitleEscape === false
                ? $this->pageTitle
                : $this->escapeHtml($this->pageTitle)
            );
        ?>
        <?php if (!empty($this->hintText)) : ?>
            <span class="govuk-hint">
               <?php  echo($this->hintText); ?>
            </span>
         <?php endif; ?>
        </h1>
        <?php if (!empty($this->pageHeaderText)) : ?>
            <div class="page-header__text">
                <p><?php
                    echo (
                        $this->pageHeaderTextEscape === false
                        ? $this->pageHeaderText
                        : $this->escapeHtml($this->pageHeaderText)
                    )
                ?></p>
            </div>
        <?php endif; ?>
    </div>
</div><!-- page-header-->
