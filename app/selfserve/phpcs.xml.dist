<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/squizlabs/php_codesniffer/phpcs.xsd">
  <file>./module</file>
  <file>./test</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <!-- Sniff files in parallel. 16 is deliberately more than most machines have cores: phpcs
       cannot detect the core count, and it splits the files into this many equal-sized batches
       up front instead of handing them out as workers free up. A batch full of heavy files then
       sets the pace while finished workers sit idle, so more, smaller batches keep the cores
       busy. Measurements are under "PHP checks" in docs/ci-cd.md. -->
  <arg name="parallel" value="16"/>

  <rule ref="./vendor/dvsa/coding-standards/src/Profiles/DVSA/CS/ruleset.xml" />

  <!-- declare(strict_types=1) before a docblock is valid modern PHP; don't require docblock-first ordering -->
  <rule ref="PSR12.Files.FileHeader.IncorrectOrder">
    <exclude-pattern>*</exclude-pattern>
  </rule>
</ruleset>
