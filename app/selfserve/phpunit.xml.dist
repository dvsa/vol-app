<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="true"
         colors="true"
         executionOrder="random"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnIncomplete="true"
         failOnSkipped="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnPhpunitWarning="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnPhpunitNotices="true"
>
  <php>
    <ini name="date.timezone" value="UTC"/>
    <!-- TableEscapingHarness reads the column config out of an exception trace to work out
         which row value a formatter rejected. With args stripped it cannot attribute the
         failure and the table is reported as unrenderable, so pin it rather than inherit
         whatever the machine's php.ini says. -->
    <ini name="zend.exception_ignore_args" value="0"/>
    <ini name="memory_limit" value="4G"/>
  </php>
  <extensions>
    <!-- Lists up to 10 tests that took over 500ms, at the end of a serial run (CI, composer test:serial).
         Report only: it never fails the run. paratest discards it, as it does all worker output.
         A test that is slow on purpose can raise its own limit with
         #[\Ergebnis\PHPUnit\SlowTestDetector\Attribute\MaximumDuration(milliseconds)].
         See "Slow tests" in docs/app/testing.md. -->
    <bootstrap class="Ergebnis\PHPUnit\SlowTestDetector\Extension">
      <parameter name="maximum-count" value="10"/>
      <parameter name="maximum-duration" value="500"/>
    </bootstrap>
  </extensions>
  <testsuites>
    <testsuite name="OLCS Selfserve Application">
      <directory>test</directory>
    </testsuite>
  </testsuites>
  <!-- failOnDeprecation applies to first-party module/ code only; PHP 8.4
       deprecations raised inside third-party vendor/ packages don't fail the suite. -->
  <source ignoreIndirectDeprecations="true">
    <include>
      <directory>module</directory>
    </include>
  </source>
</phpunit>
