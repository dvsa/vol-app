{
  "name": "ebsr-pack-upload",
  "attributes": {
    "method": "post"
  },
  "elements": [],
  "fieldsets": [
    {
      "flags": [],
      "spec": {
        "name": "fields",
        "attributes": [],
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "submissionType",
              "options": {
                "label": "ebsr-upload-type",
                "label_attributes": {
                  "class": "form-control form-control--radio"
                },
                "value_options": {
                  "ebsrt_new": "ebsr-new",
                  "ebsrt_refresh": "ebsr-refresh"
                }
              },
              "attributes": {
                "required": "required",
                "id": "submission_type",
                "placeholder": "",
                "value": "ebsrt_new"
              },
              "type": "Radio"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "uploadedFileCount",
              "attributes": {
                "required": false,
                "id": "uploadedFileCount"
              },
              "type": "Hidden"
            }
          }
        ],
        "fieldsets": [
          {
            "flags": [],
            "spec": {
              "name": "files",
              "attributes": {
                "class": "file-uploader",
                "id": "files"
              },
              "elements": [
                {
                  "flags": [],
                  "spec": {
                    "name": "file",
                    "attributes": {
                      "class": "js-visually-hidden"
                    },
                    "options": {
                      "value": "Upload .Zip file(s)",
                      "hint": "Files must be a zip file"
                    },
                    "type": "\\Common\\Form\\Elements\\Types\\AttachFilesButton"
                  }
                },
                {
                  "flags": [],
                  "spec": {
                    "name": "__messages__",
                    "attributes": [],
                    "options": [],
                    "type": "Hidden"
                  }
                },
                {
                  "flags": [],
                  "spec": {
                    "name": "upload",
                    "attributes": {
                      "data-module": "govuk-button",
                      "type": "submit",
                      "class": "inline-upload govuk-button js-upload"
                    },
                    "options": {
                      "label": "Submit"
                    },
                    "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
                  }
                }
              ],
              "fieldsets": [
                {
                  "flags": [],
                  "spec": {
                    "name": "list",
                    "attributes": {
                      "class": "js-upload-list"
                    },
                    "options": {
                      "preview_images": "false"
                    },
                    "type": "\\Common\\Form\\Elements\\Types\\FileUploadList"
                  }
                }
              ],
              "type": "Laminas\\Form\\Fieldset",
              "options": []
            }
          }
        ],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    },
    {
      "flags": [],
      "spec": {
        "name": "form-actions",
        "attributes": {
          "class": "govuk-button-group"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "submit",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "govuk-button"
              },
              "options": {
                "label": "Submit"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "options": {
    "prefer_form_input_filter": true
  },
  "type": "Common\\Form\\Form",
  "input_filter": {
    "fields": {
      "submissionType": {
        "name": "submissionType",
        "required": true
      },
      "uploadedFileCount": {
        "name": "uploadedFileCount",
        "allow_empty": true,
        "type": "Common\\InputFilter\\ContinueIfEmptyInput",
        "required": true
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
