                    "name": "Digits",
                    "options": {
                      "break_chain_on_failure": true,
                      "messages": {
                        "digitsStringEmpty": "licence.surrender.current_discs.destroy.number.emptyMessage"
                      }
                    }
                  },
                  {
                    "name": "GreaterThan",
                    "options": {
                      "min": 0,
                      "messages": {
                        "notGreaterThan": "licence.surrender.current_discs.number.greaterThanMessage"
                      }
                    }
                  }
                ]
              }
