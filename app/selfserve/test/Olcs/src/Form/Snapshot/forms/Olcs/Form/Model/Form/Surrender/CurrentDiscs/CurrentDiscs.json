        "number": {
          "name": "number",
          "required": true,
          "allow_empty": true,
          "continue_if_empty": true,
          "validators": [
            {
              "name": "ValidateIf",
              "options": {
                "context_field": "inPossession",
                "context_values": [
                  "Y"
                ],
                "inject_post_data": "possessionSection->inPossession",
                "validators": [
