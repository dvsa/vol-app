    },
    {
      "flags": [],
      "spec": {
        "name": "form-actions",
        "attributes": {
          "class": "govuk-button-group"
        },
        "elements": [
          {
            "flags": [],
            "spec": {
              "name": "submit",
              "attributes": {
                "data-module": "govuk-button",
                "type": "submit",
                "class": "govuk-button"
              },
              "options": {
                "label": "user-registration.form-actions.create-account.label"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\ActionButton"
            }
          }
        ],
        "fieldsets": [],
        "type": "Laminas\\Form\\Fieldset",
        "options": []
      }
    }
  ],
  "type": "Common\\Form\\Form",
  "options": {
    "prefer_form_input_filter": true,
    "label": "user-registration.form.label"
  },
  "input_filter": {
    "fields": {
      "loginId": {
        "name": "loginId",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          },
          {
            "name": "Laminas\\Filter\\StringToLower"
          }
        ],
        "validators": [
          {
            "name": "Dvsa\\Olcs\\Transfer\\Validators\\UsernameCreate"
          }
        ]
      },
      "forename": {
        "name": "forename",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "max": 35
            }
          }
        ]
      },
      "familyName": {
        "name": "familyName",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\StringLength",
            "options": {
              "max": 35
            }
          }
        ]
      },
      "emailAddress": {
        "name": "emailAddress",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Dvsa\\Olcs\\Transfer\\Validators\\EmailAddress"
          },
          {
            "name": "Common\\Form\\Elements\\Validators\\EmailConfirm",
            "options": {
              "token": "emailConfirm"
            }
          }
        ]
      },
      "emailConfirm": {
        "name": "emailConfirm",
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ]
      },
      "isLicenceHolder": {
        "name": "isLicenceHolder",
        "required": true
      },
      "licenceNumber": {
        "name": "licenceNumber",
        "required": true,
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ],
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isLicenceHolder",
              "context_values": [
                "Y"
              ],
              "validators": [
                {
                  "name": "Laminas\\Validator\\StringLength",
                  "options": {
                    "min": 2,
                    "max": 35
                  }
                }
              ]
            }
          }
        ]
      },
      "organisationName": {
        "name": "organisationName",
        "required": true,
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty",
            "options": [
              "null"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isLicenceHolder",
              "context_values": [
                "N"
              ],
              "validators": [
                {
                  "name": "Laminas\\Validator\\NotEmpty"
                }
              ]
            }
          }
        ],
        "filters": [
          {
            "name": "Laminas\\Filter\\StringTrim"
          }
        ]
      },
      "businessType": {
        "name": "businessType",
        "required": true,
        "validators": [
          {
            "name": "Laminas\\Validator\\NotEmpty",
            "options": [
              "string"
            ]
          },
          {
            "name": "ValidateIf",
            "options": {
              "context_field": "isLicenceHolder",
              "context_values": [
                "N"
              ],
              "validators": [
                {
                  "name": "Laminas\\Validator\\NotEmpty"
                }
              ]
            }
          }
        ]
      },
      "type": "Laminas\\InputFilter\\InputFilter"
    }
  }
}
