                "required": false
              },
              "options": {
                "label": "first-name"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "familyName",
              "attributes": {
                "id": "familyName",
                "placeholder": "",
                "class": "medium",
                "required": false
              },
              "options": {
                "label": "last-name"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "emailAddress",
              "attributes": {
                "class": "long"
              },
              "options": {
                "label": "email-address"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "emailConfirm",
              "attributes": {
                "class": "long"
              },
              "options": {
                "label": "confirm-email-address"
              },
              "type": "Text"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "isLicenceHolder",
              "options": {
                "label": "user-registration.field.isLicenceHolder.label",
                "value_options": {
                  "N": "select-option-no",
                  "Y": "select-option-yes"
                },
                "label_attributes": {
                  "class": "form-control form-control--radio form-control--inline"
                }
              },
              "attributes": {
                "required": false,
                "id": "isLicenceHolder",
                "placeholder": ""
              },
              "type": "Radio"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "licenceNumber",
              "attributes": {
                "required": "required"
              },
              "type": "Text",
              "options": {
                "label": "user-registration.field.licenceNumber.label"
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "organisationName",
              "attributes": {
                "required": "required",
                "class": "medium"
              },
              "type": "Text",
              "options": {
                "label": "user-registration.field.organisationName.label"
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "businessType",
              "attributes": {
                "required": "required"
              },
              "type": "DynamicRadio",
              "options": {
                "fieldset-attributes": {
                  "id": "businessType"
                },
                "label": "user-registration.field.businessType.label",
                "label_attributes": {
                  "class": "form-control form-control--radio"
                },
                "disable_inarray_validator": false,
                "category": "org_type",
                "exclude": [
                  "org_t_ir"
                ]
              }
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "translateToWelsh",
              "attributes": {
                "id": "translateToWelsh",
                "placeholder": ""
              },
              "options": {
                "label": "translate-to-welsh",
                "label_attributes": {
                  "class": "form-control form-control--checkbox form-control--confirm"
                },
                "checked_value": "Y",
                "unchecked_value": "N"
              },
              "type": "OlcsCheckbox"
            }
          },
          {
            "flags": [],
            "spec": {
              "name": "termsAgreed",
              "attributes": {
                "id": "termsAgreed",
                "placeholder": ""
              },
              "options": {
                "label": "user-registration.field.termsAgreed.label",
                "label_attributes": {
                  "class": "form-control form-control--checkbox form-control--confirm"
                },
                "checked_value": "Y",
                "unchecked_value": "N",
                "must_be_value": "Y"
              },
              "type": "\\Common\\Form\\Elements\\InputFilters\\SingleCheckbox"
            }
          }
        ],
        "fieldsets": [],
        "options": {
          "label": "user-registration.form.label",
          "prefer_form_input_filter": true
        },
        "type": "Laminas\\Form\\Fieldset"
